---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = '常见问题 | 赛鸽基因检测与病毒检测';
const description = '赛鸽基因检测与病毒检测常见问题解答，涵盖服务内容、样本类型、采样寄送、检测周期、报告解读等。';
const faqs = [
  { q: '赛诺检测中心提供哪些服务？', a: '我们专注于赛鸽飞行能力基因检测与病毒检测，提供影响速度、耐力、导航与整体运动潜力的关键基因标记分析，以及 12 项赛鸽常见病原的精准检测。服务面向赛鸽爱好者、育种者与兽医专业人士。' },
  { q: '基因检测是否用于人体医学用途？', a: '否。所有基因检测仅面向赛鸽（禽类/兽用），不用于人体医学诊断、治疗或临床应用。本站解读的基因信息仅适用于赛鸽生物学与性能指标。' },
  { q: '可检测哪些赛鸽 DNA 样本？', a: '我们接受多种样本：含完整羽根的羽毛、血卡样本、唾液拭子及其他推荐禽类组织。请遵循采样指南确保检测结果有效。' },
  { q: '如何采集与寄送赛鸽样本？', a: '按卫生规范采集样本（羽毛、血卡等），放入提供的包装中，填写含联系方式、赛鸽编号与检测目的的提交表，通过 DHL、FedEx、UPS 等可靠快递寄送至实验室地址。' },
  { q: '检测需要多长时间？', a: '病毒检测：样本到达实验室后 2-3 个工作日出具报告；飞行能力基因检测与 DNA 身份证/亲缘鉴定：样本到达后 7-14 个工作日出具报告。实际周期视检测量与寄送时间而定，完成后通过邮件以 PDF 形式发送结果。' },
  { q: '检测哪些基因标记？有何意义？', a: '我们分析多个与赛鸽性能相关的核心基因标记，包括 LDHA（冲刺与能量代谢）、DRD4（导航与归巢行为）、MSTN（肌肉发育与耐力）、CRY1/CLOCK（昼夜节律与比赛时机）等。报告包含标记作用解读与育种策略建议。' },
  { q: '能否解读检测结果并提供育种建议？', a: '可以。每份基因报告都包含专家对标记结果的解读及其对性能性状的潜在影响。我们不提供医学或治疗干预，但基于基因提供育种与训练决策的科学指导。' },
  { q: '赛诺是否获权威机构认可？', a: '我们依托经认证的实验室基础设施并遵循严格质量控制标准。母公司已完成相关监管注册并获技术创新认可，可应要求提供实验室认证、质控规程及高校/研究合作伙伴的文件。' },
  { q: '数据与样本信息如何保护？', a: '我们高度重视数据隐私。所有个人与赛鸽相关数据均按隐私政策处理，基因数据严格用于检测用途，未经同意不与第三方共享。' },
  { q: '不满意可以退款吗？', a: '退款或复测资格取决于具体情况：运输中样本损坏、样本不完整或不可用、经技术团队核实的前处理错误等。请参考退款政策或联系客服评估。' },
  { q: '如何联系客服获取帮助？', a: '可通过邮箱 martin@senobiocorp.com 或 WhatsApp/电话 +86 15612372623 联系，也可使用联系我们页面咨询检测、寄送或报告解读问题。' },
  { q: '飞行能力基因检测包含哪些具体基因位点？', a: '我们检测 8 个与赛鸽飞行性能相关的核心基因位点：LDHA（速度与能量代谢）、DRD4（导航与归巢）、CRY1（昼夜节律与比赛时机）、MSTN（肌肉发育与耐力）、F-KER（羽角蛋白与空气动力学）、LRP8（能量代谢与脂肪酸利用）、GSR（抗氧化与应激恢复）、CASK（神经功能与稳定性）。报告包含每个位点的基因型与育种价值解读。' },
  { q: '病毒检测覆盖哪些病原？', a: '我们提供 12 项病原检测，涵盖四大类：病毒（鸽圆环病毒、疱疹病毒、腺病毒、鸽痘病毒、轮状病毒、新城疫病毒、多瘤病毒）、细菌（沙门氏菌、鹦鹉热衣原体、支原体）、真菌（白色念珠菌）、寄生虫（毛滴虫），采用实时荧光 PCR 精准检测。' },
  { q: '什么是 DNA 身份证？与基因检测有何区别？', a: 'DNA 身份证通过 STR 微卫星标记构建每只赛鸽独一无二的 DNA 指纹图谱，用于身份核验与亲缘鉴定，图谱终身不变、无法伪造；而飞行能力基因检测关注的是与速度、耐力等性能相关的功能基因位点。两者用途不同：前者证明"这只鸽是谁"，后者评估"这只鸽的潜能"。' },
  { q: 'qPCR 检测与普通检测有何不同？', a: 'qPCR（实时荧光定量 PCR）是分子诊断的金标准，可检测极低拷贝数的病原核酸，灵敏度远高于传统培养或镜检，能在临床症状出现前 7-14 天发现病原，实现早期干预。同时通过内参质控与 UNG 防污染系统，确保结果准确可靠。' },
  { q: '赛前需要做哪些检测？', a: '建议赛前进行系统的病毒检测（覆盖 12 项常见病原），确保赛鸽不带病集鸽；如关注遗传潜能，可同步做飞行能力基因检测；名贵种鸽建议建立 DNA 身份证档案，保障交易与血统安全。' },
  { q: '检测结果会保密吗？', a: '会的。我们严格保护客户隐私与基因数据，所有检测数据仅用于约定的检测用途，未经客户明确书面同意不向任何第三方商业实体出售、出租或共享。详见隐私政策。' },
];
const faqJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: 'https://senopigeon.com/' },
      { '@type': 'ListItem', position: 2, name: '常见问题', item: 'https://senopigeon.com/faq/' },
    ],
  },
];
---

<BaseLayout {title} {description} canonical="/faq/" jsonLd={faqJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <h1 class="text-4xl font-bold">常见问题</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">赛鸽基因检测与病毒检测常见问题解答</p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="mx-auto max-w-3xl space-y-4">
      {faqs.map((f, i) => (
        <details class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between font-semibold text-gray-900">
            <span>{i + 1}. {f.q}</span>
            <span class="text-brand-600 transition group-open:rotate-45">＋</span>
          </summary>
          <p class="mt-3 leading-relaxed text-gray-600">{f.a}</p>
        </details>
      ))}
    </div>
    <p class="mt-10 text-center text-sm text-gray-500">
      本站所有服务仅面向赛鸽（禽类/兽用）应用，不适用于人体医学诊断、治疗或临床用途。
    </p>
  </section>

  <Footer />
</BaseLayout>
