---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { virusTests } from '../../data/viruses';

export function getStaticPaths() {
  return virusTests.map((v) => ({
    params: { slug: v.slug },
    props: { virus: v, others: virusTests.filter((x) => x.slug !== v.slug) },
  }));
}

const { virus, others } = Astro.props;
const title = `${virus.name}检测 | 赛鸽病毒检测`;
const rawDescription = `${virus.desc} 采用${virus.method}检测${virus.sample}，${virus.detectValue}`;
const description = rawDescription.length > 140 ? rawDescription.slice(0, 140) + '…' : rawDescription;

const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/bingdu-jiance/${virus.slug}/`;
const articleJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: `${virus.name}检测`,
    url: pageUrl,
    description: virus.desc,
    about: { '@type': 'MedicalCondition', name: virus.name, alternateName: virus.en },
    mainEntity: {
      '@type': 'MedicalCondition',
      name: virus.name,
      alternateName: virus.en,
      description: virus.desc,
      epidemiology: virus.transmission,
      possibleTreatment: virus.treatment,
      signOrSymptom: virus.symptoms.map((s) => ({ '@type': 'MedicalSymptom', name: s })),
    },
    publisher: { '@id': `${siteUrl}/#organization` },
    inLanguage: 'zh-CN',
    mainEntityOfPage: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalCondition',
    name: virus.name,
    alternateName: virus.en,
    description: virus.desc,
    epidemiology: virus.transmission,
    possibleTreatment: virus.treatment,
    signOrSymptom: virus.symptoms.map((s) => ({ '@type': 'MedicalSymptom', name: s })),
    associatedPathophysiology: virus.harm,
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '赛鸽病毒检测', item: `${siteUrl}/bingdu-jiance/` },
      { '@type': 'ListItem', position: 3, name: `${virus.name}检测`, item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} canonical={`/bingdu-jiance/${virus.slug}/`} jsonLd={articleJsonLd} type="article">
  <Header />

  <main id="main">

  <section class="bg-gradient-to-br from-accent-600 to-accent-500 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-white/80">
        <a href="/" class="hover:text-white">首页</a> /
        <a href="/bingdu-jiance/" class="hover:text-white">赛鸽病毒检测</a> /
        <span class="text-white">{virus.name}</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">{virus.name}检测</h1>
      <p class="mt-2 text-white/80">{virus.en}</p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-gray-900">病原概述</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.desc}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">传播途径</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.transmission}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">主要危害</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.harm}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">检测意义</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.detectValue}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">常见症状</h2>
        <ul class="mt-4 space-y-2">
          {virus.symptoms.map((s) => (
            <li class="flex items-start gap-2 text-gray-700">
              <span class="mt-1 text-accent-500">◆</span> {s}
            </li>
          ))}
        </ul>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">鉴别诊断</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.differential}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">潜伏期</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.incubation}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">诊断方法</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.diagnosis}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">处理与治疗</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.treatment}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">预防建议</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.prevention}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">检测流程与样本要求</h2>
        <ol class="mt-4 space-y-2 text-gray-700">
          <li>1. 采样前确认鸽只编号、症状与用药记录，避免不同鸽只共用一个拭子。</li>
          <li>2. 按靶标采集 {virus.sample}，单独密封、清晰标注，并按说明温度尽快寄送。</li>
          <li>3. 实验室进行核酸提取与 {virus.method}，同时设置阳性、阴性及内参对照。</li>
          <li>4. 报告出具后结合临床症状、流行病学与复查结果判读；必要时重新采样。</li>
        </ol>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">结果解读与局限</h2>
        <p class="mt-4 leading-relaxed text-gray-700">
          阳性表示样本中检出目标核酸，不等于一定发病；阴性也不能完全排除感染，尤其是采样时机、样本量、运输条件不理想时。核酸检测不能替代病毒分离、细菌培养、药敏或病理诊断；具体判读阈值以当前批次说明书与实验室报告为准。
        </p>
        <p class="mt-3 leading-relaxed text-gray-700">
          本页用于专业检测与科研参考，不构成兽医诊断或治疗建议。涉及阳性鸽只的隔离、用药与处置，应由执业兽医结合现场情况决定。详见
          <a href="/mianze-shengming/" class="font-semibold text-brand-700 underline">免责声明</a>。
        </p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">生物安全提示</h2>
        <ul class="mt-4 space-y-2 text-gray-700">
          <li>• 处理可疑病鸽与样本时佩戴手套、口罩，工作区与器具分开并消毒。</li>
          <li>• 阳性鸽只先隔离，避免集鸽、配对和混群；不要自行使用人用药物。</li>
          <li>• 涉及重要动物疫病时，按当地动物防疫要求报告与处置，不以单次核酸结果替代官方诊断。</li>
        </ul>

        <div class="mt-8 rounded-xl border border-accent-200 bg-accent-50/60 p-6">
          <h2 class="text-lg font-bold text-gray-900">📚 深度阅读：{virus.name} 病原百科</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            在健康知识库中查看 {virus.name} 的完整百科条目——病原特性、传播与危害、临床症状、诊断与防治指南，帮助您更系统地理解与应对这一病原。
          </p>
          <a href={`https://health.senopigeon.com/diseases/${virus.slug}/`} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-accent-700 hover:underline">
            前往健康知识库阅读 {virus.name} 百科 <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="card bg-brand-50/50">
          <h3 class="text-lg font-semibold text-gray-900">检测信息</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="font-medium text-gray-500">病原类型</dt>
              <dd class="mt-1 font-semibold text-gray-900">{virus.type}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">样本类型</dt>
              <dd class="mt-1 text-gray-700">{virus.sample}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">检测方法</dt>
              <dd class="mt-1 text-gray-700">{virus.method}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">报告周期</dt>
              <dd class="mt-1 text-gray-700">{virus.turnaround}</dd>
            </div>
          </dl>
          <a href="/lianxi/" class="btn-primary mt-6 w-full">咨询检测</a>
        </div>

        <div class="card bg-accent-500/10">
          <h3 class="text-lg font-semibold text-gray-900">采样提示</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">
            请使用无菌拭子规范采集样本，避免交叉污染；样本需单独密封、清晰标注赛鸽编号，并尽快寄送至实验室。详见
            <a href="/caiyang/" class="font-semibold text-brand-600 hover:underline">采样指南</a>。
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="text-2xl font-bold text-gray-900">其他检测项目</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((v) => (
          <a href={`/bingdu-jiance/${v.slug}/`} class="card flex items-center gap-3 hover:border-brand-300">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-lg">🔬</div>
            <div>
              <h3 class="font-semibold text-gray-900">{v.name}</h3>
              <p class="text-xs text-gray-500">{v.en}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

    </main>

  <Footer />
</BaseLayout>
