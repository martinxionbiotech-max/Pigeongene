---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { virusTests } from '../../data/viruses';

const title = '赛鸽病毒检测 | 12 项常见病原 qPCR 检测';
const description = '赛鸽病毒检测，覆盖鸽圆环病毒、疱疹病毒、腺病毒、鸽痘、轮状病毒、新城疫、多瘤病毒、沙门氏菌、白色念珠菌、毛滴虫、鹦鹉热衣原体、支原体 12 项病原，实时荧光 PCR 精准检测，可早于临床症状 7-14 天发现病原。';

const siteUrl = 'https://pigeongene.com';
const serviceJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: '赛鸽病毒检测',
    url: `${siteUrl}/bingdu-jiance/`,
    description,
    provider: { '@id': `${siteUrl}/#organization` },
    areaServed: 'Worldwide',
    serviceType: '实时荧光 qPCR 病原检测',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '赛鸽病毒检测', item: `${siteUrl}/bingdu-jiance/` },
    ],
  },
];

const scenarios = [
  { icon: '🏁', title: '赛前健康筛查', desc: '赛前系统排查病原，确保赛鸽以最佳健康状态参赛，避免带病集鸽造成成绩下滑与群体交叉感染。' },
  { icon: '🐣', title: '引种检疫', desc: '新引进种鸽、幼鸽入棚前全面检测，防止将病原带入鸽群，保障鸽场生物安全。' },
  { icon: '🚑', title: '疾病诊断', desc: '出现腹泻、呼吸道症状、神经症状、消瘦等异常时，快速锁定病原，指导精准治疗。' },
  { icon: '🛡️', title: '育雏期监控', desc: '育雏期重点监测幼鸽常见病原，降低雏鸽死亡率，提高育雏成活率。' },
  { icon: '📦', title: '疫情排查', desc: '鸽群出现集中发病或死亡时，系统排查病原，明确疫病性质，指导隔离与防控。' },
  { icon: '🌍', title: '出口/运输检疫', desc: '满足赛鸽跨区域运输、参展、出口等场景的检疫要求，出具规范检测报告。' },
];

const advantages = [
  { icon: '🎯', title: '高灵敏度', desc: '实时荧光 PCR 可检测极低拷贝数病原核酸，灵敏度远高于传统方法。' },
  { icon: '⚡', title: '快速准确', desc: '2-3 个工作日出具报告，减少等待时间，为决策提供及时依据。' },
  { icon: '🧬', title: '特异性强', desc: '针对各病原特异基因设计引物探针，有效避免交叉反应与假阳性。' },
  { icon: '📋', title: '报告规范', desc: '出具含检测方法、结果与解读的规范电子报告，满足检疫与管理需求。' },
];

const qc = [
  { icon: '📐', title: 'MIQE 合规', desc: '全部 qPCR 检测遵循 MIQE 指南，确保实验可重复、结果准确、过程透明。' },
  { icon: '🧪', title: '内参质控', desc: '每个反应均含内扩增对照，验证提取效率、检测 PCR 抑制、确认样本完整性。' },
  { icon: '🛡️', title: 'UNG 防污染', desc: 'dUTP/UNG 系统消除气溶胶残留污染，有效防止假阳性结果。' },
  { icon: '📈', title: '扩增效率监控', desc: '扩增效率维持在 95%-105%，确保低病毒载量与早期感染可靠检出。' },
];
---

<BaseLayout {title} {description} canonical="/bingdu-jiance/" jsonLd={serviceJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-accent-600 to-accent-500 py-16 text-white">
    <div class="container-x">
      <h1 class="text-4xl font-bold">赛鸽病毒检测</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/90">
        覆盖 12 项常见病原（病毒、细菌、真菌、寄生虫），采用实时荧光 qPCR 技术精准检测，可早于临床症状 7-14 天发现病原，为赛鸽健康管理与防疫提供科学依据。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/caiyang/" class="inline-flex items-center justify-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-accent-700 shadow-sm transition hover:bg-brand-50">查看采样指南</a>
        <a href="/lianxi/" class="btn-outline-light">咨询检测服务</a>
      </div>
    </div>
  </section>

  <!-- 病原项目 -->
  <section class="container-x py-16">
    <h2 class="section-title text-center">12 项病原检测项目</h2>
    <p class="mt-4 text-center text-gray-600">涵盖病毒、细菌、真菌、寄生虫四大类</p>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {virusTests.map((v) => (
        <a href={`/bingdu-jiance/${v.slug}/`} class="card hover:border-brand-300">
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{v.type}</span>
          </div>
          <h3 class="mt-4 text-xl font-bold text-gray-900">{v.name}</h3>
          <p class="mt-1 text-xs text-gray-500">{v.en}</p>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">{v.desc}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
            查看详情 <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- qPCR 金标准 -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">为什么 qPCR 是禽病检测的金标准？</h2>
      <p class="mt-4 text-center text-gray-600">从"发病后治疗"到"预测性防控"的转变</p>
      <div class="mx-auto mt-12 grid max-w-5xl gap-6 lg:grid-cols-3">
        <div class="card">
          <div class="text-3xl">⏱️</div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900">早发现窗口</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            qPCR 可在潜伏期检出病原核酸，此时赛鸽临床正常但已具传染性。相较抗原快检需要高病原载量，qPCR 能检测低拷贝病毒 DNA/RNA，实现传播扩增前的早期干预。
          </p>
          <p class="mt-3 rounded-lg bg-brand-50 px-3 py-2 text-sm font-semibold text-brand-700">
            早于临床症状 7-14 天
          </p>
        </div>
        <div class="card">
          <div class="text-3xl">🧫</div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900">qPCR + ELISA 双轨</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            qPCR 追踪活跃感染与无症状携带者，ELISA 抗体检测评估疫苗免疫应答强度。两者结合，同时掌握"感染"与"免疫"全貌，精准锁定免疫薄弱个体，避免盲目用药。
          </p>
        </div>
        <div class="card">
          <div class="text-3xl">🏭</div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900">环境监测</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            除个体检测外，还可对鸽舍空气粉尘、饮水系统、饲养设备表面及人员接触区进行环境采样，量化环境病原载量，绘制传播路径，实现系统性生物安全防控。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 质控体系 -->
  <section class="container-x py-16">
    <h2 class="section-title text-center">质量控制体系</h2>
    <p class="mt-4 text-center text-gray-600">多维度质控，确保每一份报告可靠</p>
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {qc.map((q) => (
        <div class="card text-center">
          <div class="text-3xl">{q.icon}</div>
          <h3 class="mt-3 font-semibold text-gray-900">{q.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{q.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 检测技术 -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">检测技术与流程</h2>
      <div class="mx-auto mt-10 grid max-w-5xl gap-6 text-left sm:grid-cols-2 lg:grid-cols-3">
        <div class="card">
          <h3 class="font-semibold text-gray-900">检测方法</h3>
          <p class="mt-2 text-sm text-gray-600">实时荧光 PCR（qPCR / RT-qPCR），高灵敏度检测病原遗传物质。</p>
        </div>
        <div class="card">
          <h3 class="font-semibold text-gray-900">样本类型</h3>
          <p class="mt-2 text-sm text-gray-600">泄殖腔拭子、喉拭子、粪便、口腔拭子、嗉囊液、病变组织、环境样本等。</p>
        </div>
        <div class="card">
          <h3 class="font-semibold text-gray-900">报告周期</h3>
          <p class="mt-2 text-sm text-gray-600">样本到达后 2-3 个工作日出具电子报告。</p>
        </div>
      </div>

      <h2 class="mt-16 text-center text-2xl font-bold text-gray-900">技术优势</h2>
      <div class="mx-auto mt-8 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {advantages.map((a) => (
          <div class="card text-center">
            <div class="text-3xl">{a.icon}</div>
            <h3 class="mt-3 font-semibold text-gray-900">{a.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 应用场景 -->
  <section class="container-x py-16">
    <h2 class="section-title text-center">应用场景</h2>
    <p class="mt-4 text-center text-gray-600">覆盖赛鸽全生命周期与多元场景的健康检测需求</p>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {scenarios.map((s) => (
        <div class="card">
          <div class="text-3xl">{s.icon}</div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-accent-600 to-accent-500 py-16 text-white">
    <div class="container-x text-center">
      <h2 class="text-3xl font-bold">守护赛鸽健康，从精准检测开始</h2>
      <p class="mt-4 text-white/90">提交样本，2-3 个工作日获取权威检测报告</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/caiyang/" class="inline-flex items-center justify-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-accent-700 shadow-sm transition hover:bg-brand-50">了解采样方法</a>
        <a href="/lianxi/" class="btn-outline-light">联系专家顾问</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
