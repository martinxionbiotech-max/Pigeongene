---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = '联系我们 | 咨询赛鸽检测服务';
const description = '联系张家口赛诺生物科技有限公司，咨询赛鸽飞行能力基因检测与病毒检测服务。电话 +86 13323237275。';

const siteUrl = 'https://pigeongene.com';
const contactJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: '联系我们',
    url: `${siteUrl}/lianxi/`,
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: '张家口赛诺生物科技有限公司',
    url: siteUrl,
    telephone: '+86 13323237275',
    email: 'martin@dnatestingexperts.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '桥东区北硅谷 3 号楼',
      addressLocality: '张家口市',
      addressRegion: '河北省',
      addressCountry: 'CN',
    },
  },
];
---

<BaseLayout {title} {description} canonical="/lianxi/" jsonLd={contactJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x text-center">
      <h1 class="text-4xl font-bold">联系我们</h1>
      <p class="mt-4 text-lg text-brand-100">立即开启您的赛鸽科学检测之旅</p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="card">
        <h2 class="text-2xl font-bold text-gray-900">专家顾问</h2>
        <div class="mt-6 space-y-6">
          <div class="flex items-start gap-4 rounded-lg bg-gray-50 p-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 font-bold text-white">A</div>
            <div>
              <h3 class="font-semibold text-gray-900">Aaron</h3>
              <p class="mt-1 text-sm text-gray-600">📧 <a href="mailto:aaron@dnatestingexperts.com" class="hover:text-brand-600">aaron@dnatestingexperts.com</a></p>
              <p class="text-sm text-gray-600">📞 <a href="tel:+8613313137465" class="hover:text-brand-600">+86 13313137465</a></p>
            </div>
          </div>
          <div class="flex items-start gap-4 rounded-lg bg-gray-50 p-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 font-bold text-white">M</div>
            <div>
              <h3 class="font-semibold text-gray-900">Martin</h3>
              <p class="mt-1 text-sm text-gray-600">📧 <a href="mailto:martin@dnatestingexperts.com" class="hover:text-brand-600">martin@dnatestingexperts.com</a></p>
              <p class="text-sm text-gray-600">📞 <a href="tel:+8613323237275" class="hover:text-brand-600">+86 13323237275</a></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <h2 class="text-2xl font-bold text-gray-900">实验室地址</h2>
        <p class="mt-4 leading-relaxed text-gray-700">
          中国河北省张家口市桥东区北硅谷 3 号楼
        </p>
        <div class="mt-6 rounded-xl bg-gray-50 p-4">
          <h3 class="font-semibold text-gray-900">联系方式汇总</h3>
          <ul class="mt-3 space-y-2 text-sm text-gray-600">
            <li>📧 邮箱：<a href="mailto:martin@dnatestingexperts.com" class="hover:text-brand-600">martin@dnatestingexperts.com</a></li>
            <li>📞 电话/WhatsApp：<a href="tel:+8613323237275" class="hover:text-brand-600">+86 13323237275</a></li>
            <li>📍 地址：河北省张家口市桥东区北硅谷 3 号楼</li>
          </ul>
        </div>
        <div class="mt-6">
          <a href="https://wa.me/8613323237275" target="_blank" rel="noopener" class="btn-accent w-full">WhatsApp 联系我们</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
