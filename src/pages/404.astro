---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = '页面未找到';
const description = '您访问的页面不存在，请返回首页或浏览我们的检测服务。';
---

<BaseLayout {title} {description}>
  <Header />

  <section class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-7xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-bold text-gray-900">页面未找到</h1>
    <p class="mt-4 max-w-md text-gray-600">
      您访问的页面可能已被移动、删除或从未存在。请返回首页，或浏览我们的检测服务。
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary">返回首页</a>
      <a href="/jiyin-jiance/" class="btn-outline">飞行能力基因检测</a>
      <a href="/bingdu-jiance/" class="btn-outline">赛鸽病毒检测</a>
    </div>
  </section>

  <Footer />
</BaseLayout>
