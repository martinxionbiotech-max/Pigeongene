---
// 通用 404 页面 — 内联样式，不依赖项目 BaseLayout/CSS
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>404 — Page Not Found</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #f7f8fa;
        color: #1f2937;
      }
      .wrap { text-align: center; padding: 2rem; }
      .code { font-size: 5rem; font-weight: 800; margin: 0; line-height: 1; color: #0b5cad; }
      .msg { font-size: 1.1rem; color: #4b5563; margin: 1rem 0; }
      .home { display: inline-block; padding: 0.65rem 1.5rem; border-radius: 8px; background: #0b5cad; color: #fff; text-decoration: none; font-weight: 600; }
      .home:hover { background: #0a4a8f; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p class="code">404</p>
      <p class="msg">The page you're looking for doesn't exist or has moved.</p>
      <a class="home" href="/">← Back to home</a>
    </div>
  </body>
</html>
