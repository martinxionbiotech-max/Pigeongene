---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { geneMarkers } from '../../data/genes';

const title = '赛鸽飞行能力基因检测 | 8 大核心性能基因位点';
const description = '赛鸽飞行能力 DNA 检测，精准解析 LDHA、DRD4、CRY1、MSTN、LRP8、GSR、CASK、F-KER 8 大核心基因位点，科学解读速度、耐力、归巢能力与适应性。';

const siteUrl = 'https://senopigeon.com';
const serviceJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: '赛鸽飞行能力基因检测',
    url: `${siteUrl}/jiyin-jiance/`,
    description,
    provider: { '@id': `${siteUrl}/#organization` },
    areaServed: 'Worldwide',
    offers: {
      '@type': 'Offer',
      description: '检测价格与优惠方案请咨询获取最新报价',
      priceCurrency: 'CNY',
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    '@id': `${siteUrl}/jiyin-jiance/#genes`,
    name: '赛鸽 8 大核心性能基因位点',
    description: '影响赛鸽速度、耐力、归巢能力与适应性的 8 大核心基因位点。',
    hasDefinedTerm: geneMarkers.map((g) => ({
      '@type': 'DefinedTerm',
      name: g.name,
      alternateName: g.code,
      description: g.function,
      url: `${siteUrl}/jiyin-jiance/${g.code.toLowerCase()}/`,
    })),
  },
];
---

<BaseLayout {title} {description} canonical="/jiyin-jiance/" jsonLd={serviceJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <h1 class="text-4xl font-bold">赛鸽飞行能力基因检测</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        精准解析影响速度、耐力、归巢能力与身体适应性的 8 大核心基因位点，为科学育种与训练提供可靠依据。
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {geneMarkers.map((g) => (
        <a href={`/jiyin-jiance/${g.code.toLowerCase()}/`} class="card hover:border-brand-300">
          <div class="flex items-center gap-2">
            <span class="rounded-md bg-brand-600 px-2 py-0.5 text-xs font-bold text-white">{g.code}</span>
            <span class="text-xs text-gray-500">{g.en}</span>
          </div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900">{g.name}</h3>
          <p class="mt-2 text-sm font-medium text-brand-700">功能：</p>
          <p class="text-sm text-gray-600">{g.function}</p>
          <p class="mt-3 text-sm font-medium text-brand-700">育种价值：</p>
          <p class="text-sm text-gray-600">{g.benefit}</p>
          <p class="mt-3 text-sm font-medium text-brand-700">科学关联：</p>
          <p class="text-sm text-gray-600">{g.association}</p>
          <div class="mt-3 border-t border-gray-100 pt-3 text-xs text-gray-500">
            <p><span class="font-medium text-gray-600">标记类型：</span>{g.markerType}</p>
            <p class="mt-1"><span class="font-medium text-gray-600">文献来源：</span>{g.reference}</p>
          </div>
          <span class="mt-4 inline-block text-sm font-semibold text-brand-600">查看详情 →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 价格咨询 -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <div class="mx-auto max-w-3xl rounded-2xl border border-brand-100 bg-white p-10 text-center shadow-sm">
        <div class="text-4xl">💰</div>
        <h2 class="mt-4 text-2xl font-bold text-gray-900">咨询最新价格与优惠</h2>
        <p class="mt-3 text-gray-600">
          基因检测价格与优惠方案会根据检测位点、样本数量与业务类型动态调整，请直接联系我们获取最新报价与专属优惠。
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/lianxi/" class="btn-primary">咨询最新价格</a>
          <a href="/daili/" class="btn-outline">了解大客户/代理商优惠</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 科学边界说明 -->
  <section class="container-x py-12">
    <div class="mx-auto max-w-3xl rounded-xl border border-brand-100 bg-brand-50/50 p-8">
      <h2 class="text-lg font-bold text-gray-900">基因检测的科学边界</h2>
      <p class="mt-3 text-sm leading-relaxed text-gray-600">
        基因标记仅提示赛鸽在速度、耐力、归巢能力等性状上的<b>遗传倾向</b>，而非决定性因素。赛鸽的比赛成绩是多基因、训练、环境、营养与健康等多因素共同作用的结果。我们基于现有科学文献与实验室数据提供基因型解读，但不保证基因结果能够预测或确保特定比赛成绩。检测报告仅用于禽类基因研究与科学育种参考，不构成兽医诊断。
      </p>
    </div>
  </section>

  <!-- 采样流程 -->
  <section class="container-x py-16">
    <h2 class="section-title text-center">采样流程</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-4">
      {[
        { n: '①', t: '便捷采样', d: '采集带完整羽根的羽毛或血卡样本。' },
        { n: '②', t: '安全寄送', d: '通过 DHL、FedEx 等快递寄送样本与提交表。' },
        { n: '③', t: '快速分析', d: '实验室收到后立即进行高精度 PCR 分析。' },
        { n: '④', t: '电子报告', d: '通过邮件或安全平台获取含基因解读的报告。' },
      ].map((s) => (
        <div class="card text-center">
          <div class="text-4xl font-bold text-brand-600">{s.n}</div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">{s.t}</h3>
          <p class="mt-2 text-sm text-gray-600">{s.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href="/lianxi/" class="btn-primary">立即开始检测</a>
    </div>
  </section>

  <Footer />
</BaseLayout>
