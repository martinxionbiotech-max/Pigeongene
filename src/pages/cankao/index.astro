---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = '科学参考 | 赛鸽基因检测科研文献';
const description = '赛鸽性能相关基因标记的科研文献汇总，涵盖 MSTN、DRD4、LDHA、CRY1 等关键基因的科学研究，为基因检测提供科学依据。';

const siteUrl = 'https://senopigeon.com';

const refs = [
  {
    title: 'A. Dybus 等（2013）',
    name: '不同家鸽品种肌生成抑制素基因外显子 3 的单核苷酸多态性',
    journal: 'Veterinární medicína',
    doi: 'https://doi.org/10.17221/6654-VETMED',
    summary: '该研究检测了家鸽 MSTN 基因多态性，显示不同品种间变异频率差异，提示其在肌肉发育性状中的作用。',
  },
  {
    title: 'Geert Kolvenbag 等（2022）',
    name: '基因型谱与赛鸽比赛成绩关系的前瞻性研究',
    journal: 'PMCID: PMC9365715',
    pubmed: 'https://pubmed.ncbi.nlm.nih.gov/35505002/',
    summary: '该前瞻性研究将多种基因型谱（含 DRD4 与 LDHA）与比赛成绩相关联，提示基因对表现倾向的贡献而非决定性作用。',
  },
  {
    title: 'Gazda MA 等（2018）',
    name: '赛鸽常备遗传变异的自然选择印记',
    journal: 'Molecular Biology and Evolution',
    doi: 'https://doi.org/10.1093/molbev/msy030',
    summary: '基因组研究探索了与飞行和导航能力相关的变异，提示复杂的多基因架构而非单基因效应。',
  },
  {
    title: '美国国家医学图书馆（2004）',
    name: '鸟类呼吸系统生物学',
    journal: 'PMC Article',
    pubmed: 'https://pubmed.ncbi.nlm.nih.gov/15249475/',
    summary: '综述鸟类呼吸结构及其进化适应，支持持续飞行所需的高效氧气运输。',
  },
  {
    title: 'WS Proskura（2014）',
    name: 'LDHA 基因单核苷酸多态性与信鸽比赛成绩',
    journal: 'Journal of Poultry Science',
    pdf: 'https://www.jstage.jst.go.jp/article/jpsa/51/4/51_0130237/_pdf',
    summary: '分析 LDHA 单核苷酸多态性，显示特定基因型与比赛成绩的关联，提示代谢基因变异可能影响运动性状。',
  },
  {
    title: 'Falconer DS 与 Mackay TFC',
    name: '数量遗传学导论（教科书）',
    journal: 'Textbook',
    summary: '遗传学原理、遗传力与数量性状分析的基础著作，为育种中解读遗传标记提供理论背景。',
  },
];

const scholarlyJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '赛鸽基因检测科研文献',
    itemListElement: refs.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'ScholarlyArticle',
        headline: r.title,
        name: r.name,
        description: r.summary,
        ...(r.doi ? { sameAs: r.doi } : {}),
        ...(r.pubmed ? { sameAs: r.pubmed } : {}),
      },
    })),
  },
];
---

<BaseLayout {title} {description} canonical="/cankao/" jsonLd={scholarlyJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <h1 class="text-4xl font-bold">科学参考</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        以下研究为赛鸽检测面板中性能相关基因标记提供了科学基础。基因标记仅提示潜在倾向，不决定比赛结果。
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-6">
      {refs.map((r) => (
        <div class="card">
          <h2 class="text-lg font-bold text-gray-900">{r.title}</h2>
          <p class="mt-1 font-medium text-brand-700">{r.name}</p>
          <p class="mt-1 text-xs text-gray-500">{r.journal}</p>
          {r.doi && <a href={r.doi} class="mt-2 inline-block text-sm text-brand-600 hover:underline">📄 DOI: {r.doi}</a>}
          {r.pubmed && <a href={r.pubmed} class="mt-2 inline-block text-sm text-brand-600 hover:underline">📄 PubMed: {r.pubmed}</a>}
          {r.pdf && <a href={r.pdf} class="mt-2 inline-block text-sm text-brand-600 hover:underline">📄 研究 PDF: {r.pdf}</a>}
          <p class="mt-3 text-sm leading-relaxed text-gray-600">{r.summary}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-xl border border-gray-200 bg-gray-50 p-6 text-sm text-gray-600">
      <h2 class="font-semibold text-gray-900">免责声明</h2>
      <p class="mt-2">
        以上参考文献仅用于科学透明与教育目的。赛诺生物不对这些研究主张署名权。所分析的基因标记仅用于禽类基因研究与育种参考，不构成医学诊断，也不保证比赛成绩预测。
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>
