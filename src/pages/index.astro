---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { geneMarkers } from '../data/genes';
import { virusTests } from '../data/viruses';

const title = '赛鸽基因检测中心 | 飞行能力基因检测 · 病毒检测 · DNA 身份证';
const description = '张家口森诺生物科技有限公司，国家高新技术企业，专注赛鸽飞行能力基因检测（8 大核心基因位点）、赛鸽病毒检测（11 项病原）与 DNA 身份证/亲缘鉴定，24-48 小时出具电子报告。';
---

<BaseLayout {title} {description}>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700 text-white">
    <div class="container-x grid items-center gap-10 py-20 lg:grid-cols-2 lg:py-28">
      <div>
        <p class="inline-flex items-center rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium">
          中国领先赛鸽性能 DNA 检测实验室
        </p>
        <h1 class="mt-6 text-4xl font-bold leading-tight sm:text-5xl">
          精准解析 8 大核心基因位点<br class="hidden sm:block" />
          驱动科学育种成功
        </h1>
        <p class="mt-5 text-lg text-brand-100">
          由张家口森诺生物科技有限公司提供技术支持 —— 国家高新技术企业认证
        </p>
        <p class="mt-3 text-brand-100/90">
          我们专注于赛鸽飞行能力 DNA 检测、病毒检测与 DNA 身份证/亲缘鉴定，利用高精度分子诊断技术，为全球鸽友、育种者与研究者提供可靠、数据驱动的育种与健康管理依据。
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/jiyin-jiance/" class="btn-accent">飞行能力基因检测</a>
          <a href="/bingdu-jiance/" class="btn-outline !border-white !text-white hover:!bg-white/10">赛鸽病毒检测</a>
          <a href="/dna-shenfenzheng/" class="btn-outline !border-white !text-white hover:!bg-white/10">DNA 身份证</a>
        </div>
      </div>
      <div class="relative">
        <img
          src="/wp-content/uploads/Racing-Pigeon-Performance-DNA-Testing-scaled.jpg"
          alt="赛鸽飞行能力 DNA 检测"
          class="w-full rounded-2xl shadow-2xl"
          width="1536"
          height="2048"
        />
      </div>
    </div>
  </section>

  <!-- 三大业务板块 -->
  <section class="container-x py-20">
    <div class="text-center">
      <h2 class="section-title">三大核心检测服务</h2>
      <p class="mt-4 text-lg text-gray-600">科学育种 · 健康护航 · 血统可证</p>
    </div>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      <a href="/jiyin-jiance/" class="group card hover:border-brand-300">
        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-100 text-2xl">🧬</div>
        <h3 class="mt-5 text-2xl font-bold text-gray-900">飞行能力基因检测</h3>
        <p class="mt-3 text-gray-600">
          精准解析影响速度、耐力、归巢能力与身体适应性的 8 大关键基因位点（LDHA、DRD4、CRY1、MSTN、LRP8、GSR、CASK、F-KER），为育种配对与训练提供科学依据。
        </p>
        <span class="mt-5 inline-flex items-center gap-1 font-semibold text-brand-600 group-hover:gap-2">
          了解详情 <span aria-hidden="true">→</span>
        </span>
      </a>
      <a href="/bingdu-jiance/" class="group card hover:border-brand-300">
        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-accent-500/20 text-2xl">🦠</div>
        <h3 class="mt-5 text-2xl font-bold text-gray-900">赛鸽病毒检测</h3>
        <p class="mt-3 text-gray-600">
          覆盖 12 项常见病原（鸽圆环病毒、疱疹病毒、腺病毒、鸽痘、轮状病毒、新城疫、多瘤病毒、沙门氏菌、白色念珠菌、毛滴虫、鹦鹉热衣原体、支原体），实时荧光 PCR 精准检测。
        </p>
        <span class="mt-5 inline-flex items-center gap-1 font-semibold text-brand-600 group-hover:gap-2">
          了解详情 <span aria-hidden="true">→</span>
        </span>
      </a>
      <a href="/dna-shenfenzheng/" class="group card hover:border-brand-300">
        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-100 text-2xl">🪪</div>
        <h3 class="mt-5 text-2xl font-bold text-gray-900">DNA 身份证 | 亲缘鉴定</h3>
        <p class="mt-3 text-gray-600">
          采用 STR 微卫星标记构建每只赛鸽独一无二的 DNA 指纹图谱，科学确认亲缘关系，杜绝血统造假，为种鸽认证、交易防伪与育种管理提供权威依据。
        </p>
        <span class="mt-5 inline-flex items-center gap-1 font-semibold text-brand-600 group-hover:gap-2">
          了解详情 <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <!-- 8 大基因位点 -->
  <section class="bg-gray-50 py-20">
    <div class="container-x">
      <div class="text-center">
        <h2 class="section-title">8 大核心性能基因位点</h2>
        <p class="mt-4 text-lg text-gray-600">深入解读赛鸽基因型与育种意义</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {geneMarkers.map((g) => (
          <div class="card">
            <div class="flex items-center gap-2">
              <span class="rounded-md bg-brand-600 px-2 py-0.5 text-xs font-bold text-white">{g.code}</span>
            </div>
            <h3 class="mt-3 font-semibold text-gray-900">{g.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">{g.function}</p>
            <p class="mt-3 text-sm font-medium text-brand-700">育种价值：</p>
            <p class="text-sm text-gray-600">{g.benefit}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/jiyin-jiance/" class="btn-primary">查看完整基因检测服务</a>
      </div>
    </div>
  </section>

  <!-- 病毒检测概览 -->
  <section class="bg-gray-50 py-20">
    <div class="container-x">
      <div class="text-center">
        <h2 class="section-title">12 项病毒检测项目</h2>
        <p class="mt-4 text-lg text-gray-600">覆盖赛鸽常见病毒、细菌、真菌与寄生虫病原</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {virusTests.map((v) => (
          <a href={`/bingdu-jiance/${v.slug}/`} class="card flex items-center gap-4 hover:border-brand-300">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-lg">🔬</div>
            <div>
              <h3 class="font-semibold text-gray-900">{v.name}</h3>
              <p class="text-xs text-gray-500">{v.en}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- 病毒检测技术优势 -->
      <div class="mt-12 grid gap-6 rounded-2xl border border-brand-100 bg-white p-8 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: '🎯', t: '高灵敏度', d: '实时荧光 PCR 检测极低拷贝病原核酸' },
          { icon: '⚡', t: '快速准确', d: '2-3 个工作日出具规范电子报告' },
          { icon: '🧬', t: '特异性强', d: '特异性引物探针，避免交叉反应' },
          { icon: '🔬', t: '四大类覆盖', d: '病毒·细菌·真菌·寄生虫全面检测' },
        ].map((a) => (
          <div class="text-center">
            <div class="text-3xl">{a.icon}</div>
            <h3 class="mt-3 font-semibold text-gray-900">{a.t}</h3>
            <p class="mt-2 text-sm text-gray-600">{a.d}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/bingdu-jiance/" class="btn-primary">查看全部病毒检测项目</a>
        <a href="/caiyang/" class="btn-outline">了解采样方法</a>
      </div>
    </div>
  </section>

  <!-- 优势 -->
  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-20 text-white">
    <div class="container-x">
      <div class="text-center">
        <h2 class="section-title !text-white">为什么选择森诺生物？</h2>
        <p class="mt-4 text-brand-100">信任 · 专业 · 高效</p>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/10 text-3xl">🏆</div>
          <h3 class="mt-4 text-lg font-semibold">高新技术认证</h3>
          <p class="mt-2 text-sm text-brand-100">国家高新技术企业，确保技术稳定与持续创新。</p>
        </div>
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/10 text-3xl">✅</div>
          <h3 class="mt-4 text-lg font-semibold">品质无妥协</h3>
          <p class="mt-2 text-sm text-brand-100">严格执行 ISO 质量管理标准，保证每份报告准确可靠。</p>
        </div>
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/10 text-3xl">🔬</div>
          <h3 class="mt-4 text-lg font-semibold">科学卓越</h3>
          <p class="mt-2 text-sm text-brand-100">市级重点实验室，检测方法持续验证、始终领先。</p>
        </div>
        <div class="text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/10 text-3xl">⚡</div>
          <h3 class="mt-4 text-lg font-semibold">快速出报告</h3>
          <p class="mt-2 text-sm text-brand-100">样本到达后 24-48 小时即可获取完整电子报告。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 检测流程 -->
  <section class="container-x py-20">
    <div class="text-center">
      <h2 class="section-title">检测流程：简单 · 安全 · 全球</h2>
    </div>
    <div class="mt-12 grid gap-8 md:grid-cols-4">
      {[
        { n: '①', t: '便捷采样', d: '安全采集带完整羽根的羽毛或血卡样本，接受全球鸽友的合规样本。' },
        { n: '②', t: '全球寄送', d: '通过 DHL、FedEx 等快递将样本与提交表一同寄出。' },
        { n: '③', t: '快速分析', d: '实验室收到样本后立即启动高精度 PCR 分析。' },
        { n: '④', t: '电子报告', d: '通过邮件或安全平台获取含基因解读的完整报告。' },
      ].map((s) => (
        <div class="card text-center">
          <div class="text-4xl font-bold text-brand-600">{s.n}</div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">{s.t}</h3>
          <p class="mt-2 text-sm text-gray-600">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</BaseLayout>
