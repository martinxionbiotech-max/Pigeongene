---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { dnaIdApplications, dnaIdMarkers, dnaIdProcess } from '../../data/dnaId';

const title = '赛鸽 DNA 身份证 | 亲缘鉴定';
const description = '赛鸽 DNA 身份证与亲缘鉴定服务，采用 STR 微卫星标记构建每只赛鸽独一无二的 DNA 指纹图谱，科学确认亲缘关系，杜绝血统造假，为种鸽认证、交易防伪与育种管理提供权威依据。';

const siteUrl = 'https://senopigeon.com';
const serviceJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: '赛鸽 DNA 身份证 | 亲缘鉴定',
    url: `${siteUrl}/dna-shenfenzheng/`,
    description,
    provider: { '@id': `${siteUrl}/#organization` },
    areaServed: 'Worldwide',
    serviceType: 'STR 微卫星 DNA 指纹图谱与亲缘鉴定',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'DNA 身份证 | 亲缘鉴定', item: `${siteUrl}/dna-shenfenzheng/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'DNA 身份证和血统书有什么区别？', acceptedAnswer: { '@type': 'Answer', text: '血统书依赖人工记录，可能存在记录错误或人为篡改；DNA 身份证基于鸽子的基因分型数据，客观可复核，可验证血统记录的准确性。' } },
      { '@type': 'Question', name: '亲缘鉴定能确定「父子/母子」关系吗？', acceptedAnswer: { '@type': 'Answer', text: '能。子代的每个等位基因都应在父母基因型中找到来源，通过多个 STR 标记联合分析，可给出符合或排除亲子关系的结论。' } },
      { '@type': 'Question', name: '多久出报告？', acceptedAnswer: { '@type': 'Answer', text: '样本到达实验室后 7-14 个工作日出具报告，实际周期视样本量与寄送时间而定。' } },
      { '@type': 'Question', name: '哪些场景需要做？', acceptedAnswer: { '@type': 'Answer', text: '种鸽引进核验、拍卖交易防伪、血统争议解决、终身身份建档等场景均可使用。' } },
    ],
  },
];
---

<BaseLayout {title} {description} canonical="/dna-shenfenzheng/" hreflang={[
  { lang: 'zh-CN', href: 'https://senopigeon.com/dna-shenfenzheng/' },
  { lang: 'en', href: 'https://senopigeon.com/en/dna-id-kinship/' },
  { lang: 'x-default', href: 'https://senopigeon.com/dna-shenfenzheng/' },
]} jsonLd={serviceJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-brand-100">
        <a href="/" class="hover:text-white">首页</a> /
        <span class="text-white">DNA 身份证 | 亲缘鉴定</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">赛鸽 DNA 身份证 | 亲缘鉴定</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        为每一只赛鸽建立独一无二的 DNA 身份档案，科学确认亲缘关系，让血统真实可证。
      </p>
    </div>
  </section>

  <!-- 服务介绍 -->
  <section class="container-x py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold text-gray-900">什么是赛鸽 DNA 身份证？</h2>
        <p class="mt-6 leading-relaxed text-gray-700">
          赛鸽 DNA 身份证是通过分子遗传学技术，对赛鸽基因组中的多个高变 STR（微卫星）位点进行基因分型，构建出每只赛鸽独一无二的"DNA 指纹图谱"。这份图谱终身不变、无法伪造，如同赛鸽的"基因身份证"。
        </p>
        <p class="mt-4 leading-relaxed text-gray-700">
          结合亲缘鉴定分析，可科学判断两只赛鸽之间的亲子关系（父本、母本与子代），为种鸽认证、血统证书、交易防伪与育种管理提供权威、客观的 DNA 证据。
        </p>
        <div class="mt-6 rounded-xl bg-brand-50 p-5">
          <h3 class="font-semibold text-gray-900">核心价值</h3>
          <ul class="mt-3 space-y-2 text-sm text-gray-700">
            <li>✅ 终身唯一，无法伪造顶替</li>
            <li>✅ 科学确认亲缘，杜绝血统造假</li>
            <li>✅ 提升名贵种鸽交易可信度</li>
            <li>✅ 为育种配对提供血缘依据</li>
          </ul>
        </div>
      </div>
      <div>
        <img
          src="/wp-content/uploads/IMG_44401-1-scaled.jpg"
          alt="赛鸽 DNA 身份证与亲缘鉴定"
          class="w-full rounded-2xl shadow-lg"
          width="1920"
          height="1280"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- 应用场景 -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">应用场景</h2>
      <p class="mt-4 text-center text-gray-600">DNA 身份证与亲缘鉴定的多元价值</p>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {dnaIdApplications.map((a) => (
          <div class="card">
            <div class="text-3xl">{a.icon}</div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900">{a.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 技术标记 -->
  <section class="container-x py-16">
    <h2 class="section-title text-center">检测技术标记</h2>
    <p class="mt-4 text-center text-gray-600">多种分子标记组合，确保个体识别与亲缘判断的准确性</p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {dnaIdMarkers.map((m) => (
        <div class="card">
          <div class="flex items-center gap-2">
            <span class="rounded-md bg-brand-600 px-2 py-0.5 text-xs font-bold text-white">{m.code}</span>
          </div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900">{m.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{m.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 检测流程 -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">检测流程</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-5">
        {dnaIdProcess.map((s) => (
          <div class="card text-center">
            <div class="text-3xl font-bold text-brand-600">{s.n}</div>
            <h3 class="mt-3 font-semibold text-gray-900">{s.t}</h3>
            <p class="mt-2 text-sm text-gray-600">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STR 微卫星原理 -->
  <section class="container-x py-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="section-title text-center">STR 微卫星标记：为什么它可信？</h2>
      <p class="mt-4 text-center text-gray-600">亲缘鉴定的科学基础——短串联重复序列</p>
      <div class="mt-10 space-y-6 leading-relaxed text-gray-700">
        <p>
          <b>STR（Short Tandem Repeat，短串联重复序列）</b>是基因组中一类由 2–6 个碱基为单元、首尾相连重复出现的 DNA 片段，也叫微卫星（microsatellite）。这类片段的重复次数在个体之间存在丰富的差异，因此具有很高的<b>多态性</b>——这正是它能用于个体识别与亲缘判断的根本原因。
        </p>
        <p>
          亲缘鉴定的逻辑建立在<b>孟德尔遗传规律</b>之上：子代的两条染色体分别来自父本与母本，因此在每一个 STR 位点上，子代的基因型中必有一个等位基因来自父亲、一个来自母亲。当实验室同时对多个 STR 位点进行分型时，只要某个“疑似亲本”在任何一个位点上无法提供子代所必需的等位基因，就可以在统计学上<b>排除</b>其亲缘关系；而当所有位点都符合遗传规律时，则可依据各位点的群体频率计算<b>累计亲权概率</b>，给出“支持亲缘关系”的结论。
        </p>
        <p>
          之所以可信，是因为：① STR 位点遵循稳定的共显性遗传，分型结果可重复、可复核；② 同时检测的位点数量越多，两个无关个体“偶然匹配”的概率越低，结论越可靠；③ 分型数据可长期保存，同一只赛鸽在不同时间、不同实验室间可比对。这一技术路径与国际上动物亲子鉴定的通用方法一致。
        </p>
      </div>
    </div>
  </section>

  <!-- 血统书 vs 基因指纹 -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">传统血统书 vs 基因指纹</h2>
      <p class="mt-4 text-center text-gray-600">一张纸质证明，与一份可复核的分子证据</p>
      <div class="mx-auto mt-10 max-w-4xl overflow-x-auto">
        <table class="w-full border-collapse overflow-hidden rounded-xl bg-white text-sm shadow-sm">
          <thead>
            <tr class="bg-brand-50 text-left text-brand-800">
              <th class="px-4 py-3 font-semibold">维度</th>
              <th class="px-4 py-3 font-semibold">传统血统书</th>
              <th class="px-4 py-3 font-semibold">DNA 基因指纹</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <tr class="border-t border-gray-100">
              <td class="px-4 py-3 font-medium text-gray-900">记录方式</td>
              <td class="px-4 py-3">人工登记的系谱（祖先、环号、赛绩）</td>
              <td class="px-4 py-3">多位点 STR 分型数据（分子层面）</td>
            </tr>
            <tr class="border-t border-gray-100">
              <td class="px-4 py-3 font-medium text-gray-900">可篡改性</td>
              <td class="px-4 py-3">依赖登记诚信，可能被误记或造假</td>
              <td class="px-4 py-3">个体 DNA 终身不变，无法伪造顶替</td>
            </tr>
            <tr class="border-t border-gray-100">
              <td class="px-4 py-3 font-medium text-gray-900">亲缘确认能力</td>
              <td class="px-4 py-3">仅记录宣称的亲缘，无法独立验证</td>
              <td class="px-4 py-3">可对疑似亲本进行排除/支持判定</td>
            </tr>
            <tr class="border-t border-gray-100">
              <td class="px-4 py-3 font-medium text-gray-900">可复核性</td>
              <td class="px-4 py-3">难以二次验证</td>
              <td class="px-4 py-3">数据可长期保存、跨时间跨实验室比对</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-6 max-w-4xl text-sm leading-relaxed text-gray-600">
        两者并非对立关系：血统书承载了祖先、赛绩、环号等育种历史信息，而 DNA 基因指纹为其补充了可验证的分子证据。将二者结合，才是对一只名贵种鸽最完整、最可信的价值背书。
      </p>
    </div>
  </section>

  <!-- 报告样例 -->
  <section class="container-x py-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="section-title text-center">报告样例说明</h2>
      <p class="mt-4 text-center text-gray-600">一份规范的 DNA 身份证 / 亲缘鉴定报告包含哪些内容</p>
      <div class="mt-10 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-sm text-gray-500">以下为报告结构示意（非真实检测数据，仅说明报告版式与栏目）。</p>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-gray-700">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 rounded-md bg-brand-50 px-2 py-1 text-xs font-semibold text-brand-700">基本信息</span>
            <p>赛鸽唯一编号（环号）、品种、羽色、采样类型（羽毛/血卡）、采样日期、送检方信息。</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 rounded-md bg-brand-50 px-2 py-1 text-xs font-semibold text-brand-700">DNA 身份证号</span>
            <p>根据多位点分型结果生成的唯一 DNA 身份编号，用于终身身份比对与存档。</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 rounded-md bg-brand-50 px-2 py-1 text-xs font-semibold text-brand-700">STR 分型结果表</span>
            <p>逐位点列出各 STR 位点的等位基因型，作为指纹图谱的核心数据。</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 rounded-md bg-brand-50 px-2 py-1 text-xs font-semibold text-brand-700">亲缘结论</span>
            <p>当送检多个样本时，给出“排除亲缘关系”或“支持亲缘关系（附累计概率）”的判定说明。</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 rounded-md bg-brand-50 px-2 py-1 text-xs font-semibold text-brand-700">方法说明与声明</span>
            <p>检测方法（STR 分型）、检测范围与“仅用于赛鸽禽类领域、不用于人体医学诊断”的合规声明。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 合规声明 -->
  <section class="container-x py-8">
    <div class="mx-auto max-w-3xl rounded-xl border border-amber-200 bg-amber-50 p-6">
      <p class="text-sm leading-relaxed text-gray-700">
        ⚠️ <b>服务范围声明：</b>本检测服务仅用于赛鸽（禽类/兽用）领域，不适用于人体医学诊断。亲缘鉴定结论基于所送检样本的基因分型数据，用于育种参考与身份核验。
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">常见问题</h2>
      <div class="mx-auto mt-10 max-w-3xl space-y-4">
        <div class="rounded-lg bg-white p-5 shadow-sm">
          <p class="font-semibold text-gray-900">DNA 身份证和血统书有什么区别？</p>
          <p class="mt-2 text-sm text-gray-600">血统书依赖人工记录，可能存在记录错误或人为篡改；DNA 身份证基于鸽子的基因分型数据，客观可复核，可验证血统记录的准确性。</p>
        </div>
        <div class="rounded-lg bg-white p-5 shadow-sm">
          <p class="font-semibold text-gray-900">亲缘鉴定能确定「父子/母子」关系吗？</p>
          <p class="mt-2 text-sm text-gray-600">能。子代的每个等位基因都应在父母基因型中找到来源，通过多个 STR 标记联合分析，可给出符合或排除亲子关系的结论。</p>
        </div>
        <div class="rounded-lg bg-white p-5 shadow-sm">
          <p class="font-semibold text-gray-900">多久出报告？</p>
          <p class="mt-2 text-sm text-gray-600">样本到达实验室后 7-14 个工作日出具报告，实际周期视样本量与寄送时间而定。</p>
        </div>
        <div class="rounded-lg bg-white p-5 shadow-sm">
          <p class="font-semibold text-gray-900">哪些场景需要做？</p>
          <p class="mt-2 text-sm text-gray-600">种鸽引进核验、拍卖交易防伪、血统争议解决、终身身份建档等场景均可使用。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x text-center">
      <h2 class="text-3xl font-bold">为您的赛鸽建立终身 DNA 档案</h2>
      <p class="mt-4 text-brand-100">科学鉴定亲缘，守护血统价值</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/lianxi/" class="btn-accent">咨询鉴定服务</a>
        <a href="/caiyang/" class="btn-outline-light">了解采样方法</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
