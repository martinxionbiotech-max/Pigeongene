---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { virusTestsEn } from '../../../data/virusesEn';

const title = 'Racing Pigeon Pathogen Index | 12 qPCR Tests';
const description =
  'Browse the twelve pathogens in the SENO racing-pigeon qPCR panel, including circovirus, herpesvirus, adenovirus, rotavirus, PMV-1, salmonella and trichomonas.';
const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/en/pathogens/`;
const hreflang = [
  { lang: 'en', href: pageUrl },
  { lang: 'x-default', href: pageUrl },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Racing Pigeon Pathogen Index',
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': `${siteUrl}/#website` },
    about: { '@id': `${siteUrl}/en/pathogen-testing/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Twelve pathogens in the SENO racing-pigeon qPCR panel',
    numberOfItems: virusTestsEn.length,
    itemListElement: virusTestsEn.map((virus, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: virus.name,
      url: `${siteUrl}/en/pathogens/${virus.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Pathogen Index', item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} lang="en" canonical="/en/pathogens/" {hreflang} jsonLd={jsonLd}>
  <Header />

  <main id="main">

  <section class="bg-gradient-to-br from-accent-600 to-accent-500 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-white/80" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-white">Home</a> /
        <span class="text-white">Pathogen Index</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">Racing Pigeon Pathogen Index</h1>
      <p class="mt-4 max-w-3xl text-lg text-white/90">
        Twelve common viral, bacterial, fungal and parasitic pathogens detected by real-time qPCR. Each entry links
        to the pathogen page with transmission, clinical signs, sample type and testing notes.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="max-w-3xl">
      <p class="text-lg leading-relaxed text-gray-700">
        A positive or negative result must be interpreted with clinical signs, sampling quality and flock history.
        These pages are educational and do not replace veterinary diagnosis. For panel selection and sample
        requirements, see the <a href="/en/pathogen-testing/" class="font-medium text-brand-700 underline">pathogen testing service</a>.
      </p>
    </div>

    <div class="mt-10 overflow-x-auto rounded-xl border border-gray-200">
      <table class="min-w-[860px] w-full text-left text-sm">
        <thead class="bg-gray-50 text-gray-700">
          <tr>
            <th class="px-4 py-3 font-semibold">Pathogen</th>
            <th class="px-4 py-3 font-semibold">Type</th>
            <th class="px-4 py-3 font-semibold">Sample</th>
            <th class="px-4 py-3 font-semibold">Turnaround</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {virusTestsEn.map((virus) => (
            <tr class="align-top">
              <td class="px-4 py-4 font-medium text-gray-900">
                <a href={`/en/pathogens/${virus.slug}/`} class="hover:underline">{virus.name}</a>
              </td>
              <td class="px-4 py-4 text-gray-600">{virus.type}</td>
              <td class="px-4 py-4 text-gray-600">{virus.sample}</td>
              <td class="px-4 py-4 text-gray-600">{virus.turnaround}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {virusTestsEn.map((virus) => (
        <a href={`/en/pathogens/${virus.slug}/`} class="card hover:border-brand-300">
          <span class="rounded-full bg-accent-500/20 px-2.5 py-1 text-xs font-semibold text-accent-700">{virus.type}</span>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{virus.name}</h2>
          <p class="mt-2 line-clamp-3 text-sm text-gray-600">{virus.desc}</p>
          <span class="mt-4 inline-block text-sm font-medium text-brand-700">Read pathogen page →</span>
        </a>
      ))}
    </div>
  </section>

  </main>

  <Footer />
</BaseLayout>
