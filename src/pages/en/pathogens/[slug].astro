---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { virusTestsEn } from '../../../data/virusesEn';

export function getStaticPaths() {
  return virusTestsEn.map((v) => ({
    params: { slug: v.slug },
    props: { virus: v, others: virusTestsEn.filter((x) => x.slug !== v.slug) },
  }));
}

const { virus, others } = Astro.props;

const siteUrl = 'https://senopigeon.com';
const enPath = `/en/pathogens/${virus.slug}/`;
const zhPath = `/bingdu-jiance/${virus.slug}/`;
const pageUrl = `${siteUrl}${enPath}`;

const title = `${virus.name} Testing | SENO qPCR Panel`;
const description = virus.desc.length > 155 ? virus.desc.slice(0, 152) + '…' : virus.desc;

const hreflang = [
  { lang: 'en', href: pageUrl },
  { lang: 'zh-CN', href: `${siteUrl}${zhPath}` },
  { lang: 'x-default', href: `${siteUrl}${zhPath}` },
];

const articleJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: `${virus.name} testing`,
    url: pageUrl,
    description: virus.desc,
    about: { '@type': 'MedicalCondition', name: virus.name, alternateName: virus.en },
    mainEntity: {
      '@type': 'MedicalCondition',
      name: virus.name,
      alternateName: virus.en,
      description: virus.desc,
      epidemiology: virus.transmission,
      possibleTreatment: virus.treatment,
      signOrSymptom: virus.symptoms.map((s) => ({ '@type': 'MedicalSymptom', name: s })),
    },
    publisher: { '@id': `${siteUrl}/#organization` },
    inLanguage: 'en',
    mainEntityOfPage: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalCondition',
    name: virus.name,
    alternateName: virus.en,
    description: virus.desc,
    epidemiology: virus.transmission,
    possibleTreatment: virus.treatment,
    signOrSymptom: virus.symptoms.map((s) => ({ '@type': 'MedicalSymptom', name: s })),
    associatedPathophysiology: virus.harm,
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Pathogen Testing', item: `${siteUrl}/en/pathogen-testing/` },
      { '@type': 'ListItem', position: 3, name: `${virus.name} testing`, item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} lang="en" canonical={enPath} {hreflang} jsonLd={articleJsonLd} type="article">
  <Header />

  <section class="bg-gradient-to-br from-accent-600 to-accent-500 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-white/80">
        <a href="/en/" class="hover:text-white">Home</a> /
        <a href="/en/pathogen-testing/" class="hover:text-white">Pathogen Testing</a> /
        <span class="text-white">{virus.name}</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">{virus.name} testing</h1>
      <p class="mt-2 text-white/80">{virus.en}</p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-gray-900">Pathogen overview</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.desc}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Transmission</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.transmission}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Main impact</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.harm}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Why testing matters</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.detectValue}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Common symptoms</h2>
        <ul class="mt-4 space-y-2">
          {virus.symptoms.map((s) => (
            <li class="flex items-start gap-2 text-gray-700">
              <span class="mt-1 text-accent-500">◆</span> {s}
            </li>
          ))}
        </ul>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Differential diagnosis</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.differential}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Incubation period</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.incubation}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Diagnostic methods</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.diagnosis}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Management and treatment</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.treatment}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">Prevention</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{virus.prevention}</p>

        <div class="mt-8 rounded-xl border border-accent-200 bg-accent-50/60 p-6">
          <h2 class="text-lg font-bold text-gray-900">📚 Further reading: {virus.name} encyclopaedia</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            The health knowledge base carries the full entry for {virus.name} — pathogen characteristics, transmission and impact, clinical signs, and diagnostic and control guidance.
          </p>
          <a href={`https://health.senopigeon.com/diseases/${virus.slug}/`} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-accent-700 hover:underline">
            Read the {virus.name} entry in the health knowledge base <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="card bg-brand-50/50">
          <h3 class="text-lg font-semibold text-gray-900">Testing information</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="font-medium text-gray-500">Pathogen type</dt>
              <dd class="mt-1 font-semibold text-gray-900">{virus.type}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">Sample type</dt>
              <dd class="mt-1 text-gray-700">{virus.sample}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">Method</dt>
              <dd class="mt-1 text-gray-700">{virus.method}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">Reporting</dt>
              <dd class="mt-1 text-gray-700">{virus.turnaround}</dd>
            </div>
          </dl>
          <a href="/en/contact/" class="btn-primary mt-6 w-full">Enquire about testing</a>
        </div>

        <div class="card bg-accent-500/10">
          <h3 class="text-lg font-semibold text-gray-900">Sampling note</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">
            Collect samples with sterile swabs and avoid cross-contamination; seal each sample separately, label it clearly with the pigeon ID, and send it to the laboratory promptly. See the
            <a href="/en/sampling/" class="font-semibold text-brand-600 hover:underline">sampling guide</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="text-2xl font-bold text-gray-900">Other tests in the panel</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((v) => (
          <a href={`/en/pathogens/${v.slug}/`} class="card flex items-center gap-3 hover:border-brand-300">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-lg">🔬</div>
            <div>
              <h3 class="font-semibold text-gray-900">{v.name}</h3>
              <p class="text-xs text-gray-500">{v.type}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
