---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { dnaKitsEn as dnaKits, kitTechEn as kitTech } from '../../../data/kitsEn';
import { KIT_PRICE_TEXT_EN, kitOffers } from '../../../data/pricing';

const title = 'Avian Molecular Diagnostic Kits | PCR & qPCR Test Kits';
const description = 'PCR and RT-PCR fluorescent-probe kits for bird sex identification and avian pathogen detection, with a UNG anti-contamination system. 48T/kit, 96T/kit.';

const siteUrl = 'https://senopigeon.com';
const productJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Test Kits', item: `${siteUrl}/en/kits/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Avian Molecular Diagnostic Kits',
    itemListElement: dnaKits.map((k, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Product',
        name: k.name,
        url: `${siteUrl}/en/kits/${k.slug}/`,
        category: k.category,
        description: `Target: ${k.target}; Technology: ${k.tech}`,
        brand: { '@type': 'Brand', name: 'SENO' },
        offers: kitOffers(`${siteUrl}/en/kits/${k.slug}/`),
      },
    })),
  },
];

// Category keys are read from the English kit data file; labels are the display headings.
const categoryLabels: Record<string, string> = {
  'Sex Identification': 'Sex identification kits',
  'Pathogen Detection': 'Pathogen detection kits',
};
const categories = Array.from(new Set(dnaKits.map((k) => k.category)));
---

<BaseLayout {title} {description} lang="en" canonical="/en/kits/" hreflang={[
  { lang: 'en', href: `${siteUrl}/en/kits/` },
  { lang: 'zh-CN', href: `${siteUrl}/shijihe/` },
  { lang: 'x-default', href: `${siteUrl}/shijihe/` },
]} jsonLd={productJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-brand-100">
        <a href="/en/" class="hover:text-white">Home</a> /
        <span class="text-white">Test Kits</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">Avian Molecular Diagnostic Kits</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        Molecular diagnostic and genetic testing kits based on PCR / RT-PCR fluorescent-probe technology, covering sex identification and nucleic acid detection for a range of avian pathogens.
      </p>
      <p class="mt-3 text-sm text-brand-100">Price range: {KIT_PRICE_TEXT_EN}</p>
    </div>
  </section>

  <!-- Product list -->
  <section class="container-x py-16">
    {categories.map((cat) => (
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900">{categoryLabels[cat] ?? cat}</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {dnaKits.filter((k) => k.category === cat).map((k) => (
            <a href={`/en/kits/${k.slug}/`} class="card hover:border-brand-300">
              <h3 class="font-semibold text-gray-900">{k.name}</h3>
              <p class="mt-1 text-xs text-gray-500">{k.spec}</p>
              <div class="mt-4 space-y-2 text-sm text-gray-600">
                <p><span class="font-medium text-gray-700">Target:</span>{k.target}</p>
                <p><span class="font-medium text-gray-700">Technology:</span>{k.tech}</p>
              </div>
              <span class="mt-4 inline-block text-sm font-semibold text-brand-600">View details →</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Technology platform -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">Technology platform</h2>
      <p class="mt-4 text-center text-gray-600">
        All kits use real-time PCR or RT-PCR fluorescent-probe technology combined with a UNG anti-contamination system, which reduces the risk of false positives and improves analytical reliability.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-gray-600">
        Reactions use target-specific primers and fluorescent probes and support the FAM, HEX/VIC and ROX (internal control) channels, optimised for mainstream qPCR instruments. Kits are supplied in 48T/kit and 96T/kit formats.
      </p>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {kitTech.map((t) => (
          <div class="card text-center">
            <div class="text-3xl">{t.icon}</div>
            <h3 class="mt-3 font-semibold text-gray-900">{t.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Important note -->
  <section class="container-x py-16">
    <div class="mx-auto max-w-3xl rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
      <h2 class="text-xl font-bold text-gray-900">Important note</h2>
      <p class="mt-3 leading-relaxed text-gray-600">
        These kits are intended for laboratory research and molecular testing use and are not intended for veterinary clinical diagnosis or treatment decisions. Use them according to your laboratory standard operating procedures and the relevant quality-control requirements. Results are for research and professional diagnostic use and must be interpreted by a veterinarian or laboratory professional.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="/en/contact/" class="btn-primary">Enquire about purchasing</a>
        <a href="/en/pathogen-testing/" class="btn-outline">Explore testing services</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
