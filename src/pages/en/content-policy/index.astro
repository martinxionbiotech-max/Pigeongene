---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'Content & Evidence Policy | Racing Pigeon Genetic Testing';
const description = 'SENO Biotech content and evidence policy: editorial principles, citation standards, testing methodology and veterinary disclaimer.';

const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/en/content-policy/`;
const policyJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Content & Evidence Policy',
    url: pageUrl,
    description,
    author: { '@type': 'Organization', name: 'Zhangjiakou SENO Biotech Co., Ltd.' },
    publisher: { '@id': `${siteUrl}/#organization` },
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Content & Evidence Policy', item: pageUrl },
    ],
  },
];

const sections = [
  {
    title: 'Editorial Policy',
    desc: 'Content on this site follows an evidence-first principle: scientific conclusions must be supported by verifiable published sources, and wording never exceeds what the evidence allows. Where findings are uncertain, we use qualified language such as "suggests", "may", or "associated with" — never overstatement.',
    points: [
      'Scientific claims cite verifiable sources (PMID/DOI)',
      'Associations are not written as causal conclusions',
      'Service figures (e.g. turnaround times) are kept separate from research figures',
      'Citation errors are corrected promptly and the correction is documented',
    ],
  },
  {
    title: 'Citation Standards',
    desc: 'Cited papers are verified against PMID/DOI and can be traced directly through PubMed or the publisher. Preprints (e.g. bioRxiv) are explicitly labelled "not peer-reviewed" and are used only as background reference, never in conclusive statements.',
    points: [
      'Peer-reviewed, pigeon-specific studies are preferred',
      'Preprints and reviews serve as background, not as substitutes for original research',
      'Evidence grades (A/B/C/D) are shown on gene pages and in the research center',
    ],
  },
  {
    title: 'Testing Methodology',
    desc: 'Our testing services are based on molecular diagnostic methods such as real-time fluorescent PCR (qPCR). Methodological details and quality-control procedures are published in the research center. Descriptions on this site match actual laboratory practice; we do not fabricate equipment, accreditations, or testing parameters.',
    points: [
      'qPCR: primer/probe design, internal controls, UNG anti-contamination',
      'STR typing: marker systems for kinship verification and DNA IDs',
      'Quality control: positive/negative controls and internal amplification controls per batch',
    ],
  },
  {
    title: 'Veterinary Disclaimer',
    desc: 'Content on this site and all sub-sites (genetics, health, research, tools) is for educational and breeding reference only. It does not constitute veterinary diagnosis or treatment advice. If your pigeons show signs of illness, consult a licensed veterinarian; test reports should be interpreted together with clinical signs, epidemiology, and loft management.',
    points: [
      'Symptoms alone cannot confirm a diagnosis; laboratory testing is the basis',
      'A single negative result does not exclude infection',
      'Medication and treatment decisions should follow a licensed veterinarian\u2019s advice',
    ],
  },
];
const hreflang = [
  { lang: 'en', href: pageUrl },
  { lang: 'zh-CN', href: `${siteUrl}/zhishi/neirong-zhengce/` },
  { lang: 'x-default', href: `${siteUrl}/zhishi/neirong-zhengce/` },
];
---

<BaseLayout {title} {description} lang="en" canonical="/en/content-policy/" {hreflang} jsonLd={policyJsonLd} type="article">
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <h1 class="text-4xl font-bold">Content & Evidence Policy</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        Scientific, transparent, traceable — the three bottom lines of our content.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="mx-auto max-w-3xl space-y-10">
      {sections.map((s) => (
        <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
          <h2 class="text-2xl font-bold text-gray-900">{s.title}</h2>
          <p class="mt-3 leading-relaxed text-gray-700">{s.desc}</p>
          <ul class="mt-4 space-y-2">
            {s.points.map((p) => (
              <li class="flex items-start gap-2 text-sm text-gray-600">
                <span class="mt-0.5 text-brand-600">✓</span> {p}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-2xl font-bold text-gray-900">Related Resources</h2>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/en/flight-gene-test/" class="btn-outline">Flight Gene Test</a>
          <a href="/en/pathogen-testing/" class="btn-outline">Pathogen Testing</a>
          <a href="https://research.senopigeon.com/research/evidence-grading/" class="btn-outline">Evidence Grading</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
