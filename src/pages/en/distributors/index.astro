---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'Distributor Partnership | Pigeon Genetic Testing';
const description = 'Partner with SENO on avian DNA testing and molecular diagnostics: regional distribution, marketing collaboration and laboratory setup support.';

const siteUrl = 'https://senopigeon.com';
const breadcrumbJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Distributor Partnership', item: `${siteUrl}/en/distributors/` },
    ],
  },
];

const opportunities = [
  {
    icon: '🤝',
    title: 'Regional distribution',
    desc: 'We are recruiting regional representatives and market distributors to promote avian DNA testing and PCR diagnostic services and to build a local customer network.',
    items: ['Avian DNA sex identification services', 'Racing pigeon genetic testing', 'Avian virus PCR testing', 'Laboratory reagent distribution', 'Sample collection and shipping support'],
  },
  {
    icon: '📣',
    title: 'Promotion and marketing collaboration',
    desc: 'We welcome online platforms, pigeon fancier communities, breeders, racing pigeon clubs, veterinary channels and digital marketing partners.',
    items: ['Brand promotion', 'Referral collaboration', 'Joint education projects', 'Technical content collaboration', 'Regional market development'],
  },
  {
    icon: '🔬',
    title: 'Laboratory setup and technical collaboration',
    desc: 'We support partners who want to establish an avian molecular testing laboratory locally.',
    items: ['PCR laboratory workflow design', 'Equipment selection guidance', 'Reagent system recommendations', 'Testing protocol optimisation', 'Technical training assistance', 'Laboratory start-up consulting'],
  },
];

const advantages = [
  { icon: '💰', title: 'Competitive margin structure', desc: 'Strong commercial support and a competitive pricing policy for long-term partners and regional distributors.' },
  { icon: '🛡️', title: 'Regional exclusivity', desc: 'Qualified tier-one regional partners can be given a strict market exclusivity agreement, with local enquiries routed directly into your network.' },
  { icon: '⚡', title: 'Priority testing service', desc: 'Partners and distributors receive priority handling support for testing services and sample processing, improving turnaround.' },
  { icon: '🎓', title: 'Technical training support', desc: 'Ongoing support on avian DNA testing workflows, PCR/qPCR systems, sampling procedures, laboratory operations and report interpretation.' },
  { icon: '🧪', title: 'Product and reagent support', desc: 'Molecular diagnostic reagents and PCR test kits for avian sex identification, racing pigeon pathogen testing and psittacine disease screening.' },
  { icon: '✈️', title: 'Compliance and cold-chain support', desc: 'The export team provides COA, SDS/MSDS and export compliance documents to keep international customs clearance smooth.' },
];

const steps = [
  { n: '①', t: 'Learn about the partnership', d: 'Understand our business and partnership models and decide on your interest.' },
  { n: '②', t: 'Submit an application', d: 'Send your company or personal profile, market focus and an assessment of sales potential.' },
  { n: '③', t: 'Discussion and agreement', d: 'Both sides discuss the details and sign a partnership agreement.' },
  { n: '④', t: 'Kick-off', d: 'Receive training and support and begin local operations.' },
];
---

<BaseLayout {title} {description} lang="en" canonical="/en/distributors/" hreflang={[
  { lang: 'en', href: `${siteUrl}/en/distributors/` },
  { lang: 'zh-CN', href: `${siteUrl}/daili/` },
  { lang: 'x-default', href: `${siteUrl}/daili/` },
]} jsonLd={breadcrumbJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-brand-100">
        <a href="/en/" class="hover:text-white">Home</a> /
        <span class="text-white">Distributor Partnership</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">Become our partner</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        We invite partners worldwide in avian molecular diagnostics, DNA testing and PCR testing services to develop the market with us.
      </p>
    </div>
  </section>

  <!-- Partnership opportunities -->
  <section class="container-x py-16">
    <h2 class="section-title text-center">Partnership opportunities</h2>
    <p class="mt-4 text-center text-gray-600">Several ways to work together, growing side by side</p>
    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {opportunities.map((o) => (
        <div class="card">
          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-100 text-3xl">{o.icon}</div>
          <h3 class="mt-5 text-xl font-bold text-gray-900">{o.title}</h3>
          <p class="mt-3 text-sm text-gray-600">{o.desc}</p>
          <ul class="mt-4 space-y-2 text-sm text-gray-600">
            {o.items.map((it) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-brand-500">•</span> {it}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Advantages -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">Why partner with us</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {advantages.map((a) => (
          <div class="card">
            <div class="text-3xl">{a.icon}</div>
            <h3 class="mt-3 font-semibold text-gray-900">{a.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Application process -->
  <section class="container-x py-16">
    <h2 class="section-title text-center">How to apply</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-4">
      {steps.map((s) => (
        <div class="card text-center">
          <div class="text-4xl font-bold text-brand-600">{s.n}</div>
          <h3 class="mt-3 font-semibold text-gray-900">{s.t}</h3>
          <p class="mt-2 text-sm text-gray-600">{s.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <p class="text-gray-600">Ready to develop the market in your region? Contact us and send us your partnership enquiry.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/en/contact/" class="btn-primary">Contact us now</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
