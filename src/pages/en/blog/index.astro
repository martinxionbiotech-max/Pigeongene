---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

// English articles come from two sources:
//  * `blog` with lang === 'en'  — posts written in English with no Chinese original
//  * `blog-en`                  — translations of the Chinese posts, same slug
const writtenInEnglish = (await getCollection('blog')).filter((p) => p.data.lang === 'en');
const translations = await getCollection('blog-en');
const posts = [...writtenInEnglish, ...translations].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Articles | Racing Pigeon Gene and Pathogen Testing';
const description =
  'Technical articles on racing pigeon gene testing, pathogen testing, DNA identification, breeding and loft health management from our laboratory team.';

const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/en/blog/`;

const canonicalPath = '/en/blog/';

const hreflang = [
  { lang: 'en', href: pageUrl },
  { lang: 'zh-CN', href: `${siteUrl}/blog/` },
  { lang: 'x-default', href: `${siteUrl}/blog/` },
];

const listJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Racing pigeon gene and pathogen testing articles',
    url: pageUrl,
    description,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: pageUrl },
    ],
  },
];

const categories = [...new Set(posts.map((p) => p.data.category))];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout {title} {description} lang="en" canonical={canonicalPath} {hreflang} jsonLd={listJsonLd} type="article">
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-brand-100">
        <a href="/en/" class="hover:text-white">Home</a> /
        <span class="text-white">Articles</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">Articles</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        In-depth writing on racing pigeon gene testing, pathogen testing and scientific breeding, from our laboratory team.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    {categories.map((cat) => (
      <div class="mb-12">
        <h2 class="mb-6 text-xl font-bold text-gray-900">{cat}</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts
            .filter((p) => p.data.category === cat)
            .map((post) => (
              <a href={`/en/blog/${post.slug}/`} class="group card flex flex-col hover:border-brand-300">
                <div class="flex items-center gap-2 text-xs text-brand-600">
                  <span class="rounded-full bg-brand-50 px-2 py-0.5">{post.data.category}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
                </div>
                <h3 class="mt-3 text-lg font-bold text-gray-900 group-hover:text-brand-700">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm text-gray-600">{post.data.description}</p>
                <div class="mt-auto flex flex-wrap gap-1 pt-4">
                  {post.data.tags.map((t) => (
                    <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-500">{t}</span>
                  ))}
                </div>
              </a>
            ))}
        </div>
      </div>
    ))}
  </section>

  <section class="bg-gray-50 py-16">
    <div class="container-x text-center">
      <h2 class="section-title">Looking for professional testing?</h2>
      <p class="mt-4 text-gray-600">From genes to pathogens — build a complete scientific record for your pigeons.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/en/flight-gene-test/" class="btn-primary">Gene testing</a>
        <a href="/en/pathogen-testing/" class="btn-outline">Pathogen testing</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
