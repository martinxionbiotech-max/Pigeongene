---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = 'Articles | Racing Pigeon Genetic Testing';
const description = 'Practical guides on racing-pigeon pathogen testing, flight-gene reports, sampling and loft management from the SENO Biotech laboratory team.';

const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/en/blog/`;

const listJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Racing Pigeon Testing Articles',
    url: pageUrl,
    description,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: pageUrl },
    ],
  },
];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout {title} {description} lang="en" canonical="/en/blog/" jsonLd={listJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <h1 class="text-4xl font-bold">Articles</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        Practical guides on pigeon testing, gene reports and loft management.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="mx-auto grid max-w-4xl gap-6">
      {posts.map((post) => (
        <a
          href={`/en/blog/${post.slug}/`}
          class="card group block transition hover:shadow-md"
        >
          <p class="text-xs font-medium uppercase tracking-wide text-brand-600">
            {post.data.category}
          </p>
          <h2 class="mt-2 text-xl font-bold text-gray-900 group-hover:text-brand-700">
            {post.data.title}
          </h2>
          <p class="mt-2 text-sm text-gray-600">{post.data.description}</p>
          <p class="mt-3 text-xs text-gray-400">
            {fmtDate(post.data.pubDate)} · {post.data.tags.join(', ')}
          </p>
        </a>
      ))}
      {posts.length === 0 && (
        <p class="text-center text-gray-500">No articles yet.</p>
      )}
    </div>
  </section>

  <Footer />
</BaseLayout>
