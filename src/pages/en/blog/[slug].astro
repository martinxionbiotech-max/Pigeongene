---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => p.data.lang === 'en')
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, category, tags, author, authorRole, updatedDate } = post.data;

const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/en/blog/${post.slug}/`;

const articleJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: pageUrl,
    datePublished: pubDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    author: {
      '@type': 'Person',
      name: author,
      ...(authorRole ? { jobTitle: authorRole } : {}),
      affiliation: { '@id': `${siteUrl}/#organization` },
    },
    publisher: { '@id': `${siteUrl}/#organization` },
    keywords: tags.join(','),
    inLanguage: 'en',
    mainEntityOfPage: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: `${siteUrl}/en/blog/` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout {title} {description} lang="en" canonical={`/en/blog/${post.slug}/`} jsonLd={articleJsonLd} type="article">
  <Header />

  <article>
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">Home</a> /
          <a href="/en/blog/" class="hover:text-white">Articles</a> /
          <span class="text-white">{title}</span>
        </nav>
        <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-tight md:text-4xl">{title}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-brand-100">
          <span>{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{category}</span>
        </div>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-3xl">
        <div class="prose prose-brand max-w-none">
          <Content />
        </div>
        <div class="mt-10 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="rounded bg-gray-100 px-3 py-1 text-sm text-gray-600">{t}</span>
          ))}
        </div>
        <div class="mt-10 rounded-xl border border-brand-100 bg-brand-50/50 p-6 text-center">
          <p class="text-gray-700">Need pathogen or flight-gene testing for your pigeons?</p>
          <div class="mt-4 flex flex-wrap justify-center gap-3">
            <a href="/en/pathogen-testing/" class="btn-primary">Pathogen Testing</a>
            <a href="/en/flight-gene-test/" class="btn-outline">Flight Gene Test</a>
          </div>
        </div>
        <div class="mt-8">
          <a href="/en/blog/" class="text-sm font-medium text-brand-600 hover:text-brand-700">← All articles</a>
        </div>
      </div>
    </section>
  </article>

  <Footer />
</BaseLayout>
