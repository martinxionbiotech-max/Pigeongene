---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'Racing Pigeon Knowledge Centre | PCR, Health & DNA Guides';
const description =
  'Guides to racing pigeon gene testing, qPCR pathogen detection, DNA ID and parentage testing, sampling and how to read a test report.';

const siteUrl = 'https://senopigeon.com';
const canonicalPath = '/en/knowledge/';

const hreflang = [
  { lang: 'en', href: `${siteUrl}${canonicalPath}` },
  { lang: 'zh-CN', href: `${siteUrl}/zhishi/` },
  { lang: 'x-default', href: `${siteUrl}/zhishi/` },
];

const hubJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Racing Pigeon Gene Testing Knowledge Centre',
    url: `${siteUrl}${canonicalPath}`,
    inLanguage: 'en',
  },
];

const categories = [
  {
    icon: '🧬',
    title: 'How gene testing works',
    desc: 'The principles and applications of PCR, qPCR, STR typing and other molecular testing methods.',
    href: '/en/knowledge/pcr-principles/',
    count: '6 articles',
  },
  {
    icon: '🦠',
    title: 'Viruses & pathogens',
    desc: 'The 12 common pathogens of racing pigeons: transmission, impact and control points.',
    href: '/en/pathogen-testing/',
    count: '12 items',
  },
  {
    icon: '📝',
    title: 'Sampling & shipping',
    desc: 'Standardised sampling and shipping so that test results stay accurate and reliable.',
    href: '/en/sampling/',
    count: '5 steps',
  },
  {
    icon: '📊',
    title: 'Report guide',
    desc: 'How to read a gene test report and understand the link between genotype and traits.',
    href: '/en/knowledge/report-guide/',
    count: 'Guide',
  },
  {
    icon: '📚',
    title: 'Scientific literature',
    desc: 'The published research behind each test, kept openly documented.',
    href: '/en/references/',
    count: '6 papers',
  },
  {
    icon: '❓',
    title: 'FAQ',
    desc: 'Answers to common questions about testing services, samples, turnaround and reports.',
    href: '/en/faq/',
    count: '18 Q&A',
  },
  {
    icon: '📰',
    title: 'Articles',
    desc: 'In-depth pieces on DNA sexing, PMV control and pathogen monitoring programmes.',
    href: '/en/blog/',
    count: '6 articles',
  },
  {
    icon: '🏗️',
    title: 'Laboratory build',
    desc: 'Zoning, equipment list and construction workflow for an avian genetics laboratory.',
    href: '/en/laboratory/',
    count: 'Plan',
  },
];
---

<BaseLayout {title} {description} lang="en" canonical={canonicalPath} {hreflang} jsonLd={hubJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-brand-100">
        <a href="/en/" class="hover:text-white">Home</a> /
        <span class="text-white">Knowledge Centre</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">Racing Pigeon Gene Testing Knowledge Centre</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        A systematic, authoritative and transparent encyclopaedia of racing pigeon gene testing, helping fanciers and breeders understand the principles, methods and results behind every test.
      </p>
    </div>
  </section>

  <!-- Category navigation -->
  <section class="container-x py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <a href={c.href} class="card group hover:border-brand-300">
          <div class="flex items-center justify-between">
            <div class="text-3xl">{c.icon}</div>
            <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{c.count}</span>
          </div>
          <h2 class="mt-4 text-lg font-bold text-gray-900">{c.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{c.desc}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 group-hover:gap-2">
            Read more <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Ecosystem knowledge bases -->
  <section class="container-x py-16">
      <h2 class="section-title text-center">Ecosystem knowledge bases</h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-gray-600">
        Three specialist knowledge bases built by the SENO Gene Testing Centre complement our main-site testing services, offering a systematic body of knowledge that runs from genetic principles through to health management.
      </p>
      <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-2">
        <a href="https://genetics.senopigeon.com" target="_blank" rel="noopener" class="card group hover:border-brand-300">
          <div class="flex items-center gap-3">
            <span class="text-3xl">🧬</span>
            <div>
              <h3 class="font-bold text-gray-900">Genetics knowledge base</h3>
              <p class="text-xs text-gray-500">genetics.senopigeon.com</p>
            </div>
          </div>
          <p class="mt-3 text-sm text-gray-600">Candidate-gene loci with published pigeon research, genetic markers, and breeding genetics and inheritance patterns, explained systematically.</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 group-hover:gap-2">Open the knowledge base →</span>
        </a>
        <a href="https://health.senopigeon.com" target="_blank" rel="noopener" class="card group hover:border-brand-300">
          <div class="flex items-center gap-3">
            <span class="text-3xl">🦠</span>
            <div>
              <h3 class="font-bold text-gray-900">Health knowledge base</h3>
              <p class="text-xs text-gray-500">health.senopigeon.com</p>
            </div>
          </div>
          <p class="mt-3 text-sm text-gray-600">The 12 common pathogens of racing pigeons, a symptom index, and biosecurity and vaccination guides.</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 group-hover:gap-2">Open the knowledge base →</span>
        </a>
        <a href="https://research.senopigeon.com" target="_blank" rel="noopener" class="card group hover:border-brand-300">
          <div class="flex items-center gap-3">
            <span class="text-3xl">🔬</span>
            <div>
              <h3 class="font-bold text-gray-900">Research centre</h3>
              <p class="text-xs text-gray-500">research.senopigeon.com</p>
            </div>
          </div>
          <p class="mt-3 text-sm text-gray-600">Published literature supporting our tests, research progress and evidence-level interpretation.</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 group-hover:gap-2">Open the research centre →</span>
        </a>
      </div>
  </section>

  <!-- Why a knowledge centre -->
  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <h2 class="section-title text-center">Why a knowledge centre?</h2>
      <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
        <div class="card">
          <h3 class="font-semibold text-gray-900">📖 Scientific transparency</h3>
          <p class="mt-2 text-sm text-gray-600">We publish the principles and scientific basis of each test, so every result is traceable rather than a "black box".</p>
        </div>
        <div class="card">
          <h3 class="font-semibold text-gray-900">🎓 Plain-language education</h3>
          <p class="mt-2 text-sm text-gray-600">We explain specialist gene-testing knowledge in everyday language, helping fanciers move from breeding "by experience" to breeding informed by data.</p>
        </div>
        <div class="card">
          <h3 class="font-semibold text-gray-900">🤝 Industry collaboration</h3>
          <p class="mt-2 text-sm text-gray-600">We keep building shared knowledge in racing pigeon gene testing, supporting industry standards and the wider adoption of the technology.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
