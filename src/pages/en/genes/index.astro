---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { geneMarkersEn } from '../../../data/genesEn';

const title = 'Racing Pigeon Gene Marker Index | 8 Candidate Loci';
const description =
  'Browse the eight candidate loci in the SENO racing-pigeon flight-gene panel: LDHA, DRD4, CRY1, MSTN, F-KER, LRP8, GSR and CASK, with function and evidence.';
const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/en/genes/`;
const hreflang = [
  { lang: 'en', href: pageUrl },
  { lang: 'x-default', href: pageUrl },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Racing Pigeon Gene Marker Index',
    description,
    url: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@id': `${siteUrl}/#website` },
    about: { '@id': `${siteUrl}/en/flight-gene-test/#genes` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Eight candidate gene loci in the SENO racing-pigeon panel',
    numberOfItems: geneMarkersEn.length,
    itemListElement: geneMarkersEn.map((gene, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${gene.name} (${gene.code})`,
      url: `${siteUrl}/en/genes/${gene.code.toLowerCase()}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Gene Marker Index', item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} lang="en" canonical="/en/genes/" {hreflang} jsonLd={jsonLd}>
  <Header />

  <main id="main">

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-brand-100" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-white">Home</a> /
        <span class="text-white">Gene Marker Index</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">Racing Pigeon Gene Marker Index</h1>
      <p class="mt-4 max-w-3xl text-lg text-brand-100">
        A compact index of the eight candidate loci used in the SENO flight-gene panel. Each entry links to the
        marker page with its biological function, published association and scientific boundaries.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="max-w-3xl">
      <p class="text-lg leading-relaxed text-gray-700">
        These markers are candidate-gene references, not a prediction of race results. Read each result alongside
        training, health, environment, pedigree and race records. For the testing service itself, see the
        <a href="/en/flight-gene-test/" class="font-medium text-brand-700 underline">flight-gene test page</a>.
      </p>
    </div>

    <div class="mt-10 overflow-x-auto rounded-xl border border-gray-200">
      <table class="min-w-[820px] w-full text-left text-sm">
        <thead class="bg-gray-50 text-gray-700">
          <tr>
            <th class="px-4 py-3 font-semibold">Marker</th>
            <th class="px-4 py-3 font-semibold">Gene</th>
            <th class="px-4 py-3 font-semibold">Biological function</th>
            <th class="px-4 py-3 font-semibold">Evidence note</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {geneMarkersEn.map((gene) => (
            <tr class="align-top">
              <td class="px-4 py-4 font-bold text-brand-700">
                <a href={`/en/genes/${gene.code.toLowerCase()}/`} class="hover:underline">{gene.code}</a>
              </td>
              <td class="px-4 py-4 font-medium text-gray-900">
                <a href={`/en/genes/${gene.code.toLowerCase()}/`} class="hover:underline">{gene.name}</a>
              </td>
              <td class="px-4 py-4 text-gray-600">{gene.function}</td>
              <td class="px-4 py-4 text-gray-600">{gene.association}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {geneMarkersEn.map((gene) => (
        <a href={`/en/genes/${gene.code.toLowerCase()}/`} class="card hover:border-brand-300">
          <span class="rounded-md bg-brand-600 px-2 py-0.5 text-xs font-bold text-white">{gene.code}</span>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{gene.name}</h2>
          <p class="mt-2 line-clamp-3 text-sm text-gray-600">{gene.function}</p>
          <span class="mt-4 inline-block text-sm font-medium text-brand-700">Read marker →</span>
        </a>
      ))}
    </div>
  </section>

  </main>

  <Footer />
</BaseLayout>
