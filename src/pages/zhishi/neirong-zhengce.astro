---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = '内容与证据政策 | 赛鸽基因检测知识中心';
const description = '赛诺生物内容与证据政策：编辑独立性、作者与审稿、A/B/C/D 证据分级、PMID/DOI 引用、检测方法学、报告解释边界、更正机制与兽医免责声明。';

const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/zhishi/neirong-zhengce/`;
const articleJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: '内容与证据政策',
    url: pageUrl,
    description,
    author: { '@type': 'Organization', name: '张家口赛诺生物科技有限公司' },
    publisher: { '@id': `${siteUrl}/#organization` },
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '知识中心', item: `${siteUrl}/zhishi/` },
      { '@type': 'ListItem', position: 3, name: '内容与证据政策', item: pageUrl },
    ],
  },
];

const sections = [
  {
    title: '1. 适用范围与承诺',
    desc: '本政策适用于 senopigeon.com 及其遗传知识库、健康知识库、科研中心、在线工具和检测报告中的科普、技术与方法学内容。我们的承诺是：可核验、可追溯、不过度外推；商业目标不改变证据强度，也不把关联性写成因果性。',
    points: [
      '科学结论须有可核验来源；无法核验的内容不作为结论',
      '服务参数（周期、规格、价格）与科研数字分开表述',
      '不确定结论使用「提示」「可能」「关联」「尚需验证」等限定词',
      '内容更新时保留日期与版本，重大更正单独说明',
    ],
  },
  {
    title: '2. 编辑独立性与商业利益披露',
    desc: '我们销售赛鸽检测服务与试剂盒，因此本站内容存在商业利益。编辑原则不因商业利益改变：不夸大检测能力，不贬低竞品，不虚构客户、认证、专利或检测性能。涉及自家产品时，优先说明适用边界、局限与替代方案。',
    points: [
      '产品页同时说明适用对象、样本要求、局限与不能保证的结果',
      '不把候选基因关联写成「决定成绩」或「保证育种价值」',
      '不虚构客户评价、检测量、合作机构或认证范围',
      '发现利益冲突时，在页面或报告中披露',
    ],
  },
  {
    title: '3. 作者、审稿与责任',
    desc: '技术文章由实验室团队或特邀作者撰写，涉及基因、病原、兽医与法规的内容由具备相应背景的技术审稿人复核。页面署名可以是机构或作者姓名；未署名的科普页视为机构内容，由实验室团队承担责任。',
    points: [
      '作者/审稿人应具备相关领域培训或实践经验',
      '报告解读与兽医建议分开：前者是实验室信息，后者由执业兽医师提供',
      '外部作者需披露所属机构与利益关系',
      '读者发现事实错误可通过文末邮箱提交，我们按第 9 节处理',
    ],
  },
  {
    title: '4. 证据等级 A/B/C/D',
    desc: '证据等级描述的是「现有研究对某项关联的支持强度」，不是商业重要性，也不是对单个检测结果的保证。等级用于帮助读者判断措辞强度；未标注等级的页面按较低等级解读，不能作为结论性依据。',
    points: [
      'A：多项独立、同行评审的鸽类研究，并有功能或独立队列支持',
      'B：至少一项同行评审的鸽类关联研究，或机制与关联证据相互支持',
      'C：初步、单一或探索性研究；结果需重复验证',
      'D：假设性、背景性、未经验证或仅来自非鸽类物种；只作参考',
    ],
  },
  {
    title: '5. 文献引用与核验',
    desc: '引用优先使用同行评审的鸽类原始研究，其次为综述与机制研究。我们要求提供 PMID、DOI 或出版社链接，便于读者直接核验；预印本必须标注「未经同行评审」，不得进入结论性表述。历史页面正在分批补齐可点击链接。',
    points: [
      '不引用无法核验的二手摘要、营销稿或未注明来源的图片',
      '区分「统计关联」「因果关系」「机制推断」三种表述',
      '同一结论存在冲突研究时，说明冲突而不是只选支持自己的结果',
      '引用错误优先更正；无法确认来源的内容删除或降级为背景',
    ],
  },
  {
    title: '6. 检测方法学与质控',
    desc: '检测服务基于实时荧光定量 PCR（qPCR）、STR 分型等分子生物学方法。方法学细节、样本类型、质控与判读规则以项目说明、报告和实验室 SOP 为准；本站不虚构设备、认证、试剂性能或检测参数。',
    points: [
      'qPCR：引物/探针设计、阳性/阴性对照、内参或内扩增对照、UNG 防污染',
      'STR：用于 DNA 身份证与亲缘鉴定的标记体系及判读规则',
      '样本：按采样指南采集、保存与寄送；不合格样本可要求重采',
      '性能数字（LoD、灵敏度、特异性）须有验证记录或批次 COA，否则不宣称',
    ],
  },
  {
    title: '7. 报告与结果解释边界',
    desc: '报告只针对来样与订单项目，结果是概率性/关联性信息，不是成绩预测、健康诊断或育种保证。病原检测阳性不等于临床发病，单次阴性也不能完全排除感染；解释必须结合临床症状、流行病学、采样质量与饲养管理。',
    points: [
      '基因结果受多基因、训练、营养、环境、健康与随机因素影响',
      '报告中的证据等级、方法、局限与参考来源应一起阅读',
      '不要仅凭报告自行用药、淘汰种鸽或进行高风险交易',
      '兽医诊断与治疗请咨询执业兽医师',
    ],
  },
  {
    title: '8. 自动化工具与 AI 使用',
    desc: '我们可能使用自动化工具辅助排版、翻译、检索或初稿整理，但不会让工具代替事实核验。任何进入页面的科学结论、数字、引用、认证与客户信息，必须由编辑人工核对；不得使用 AI 生成虚构数据、证书、评价或检测性能。',
    points: [
      'AI 辅助内容须经人工事实核查与编辑',
      '不得生成或拼接虚假参考文献、PMID/DOI 或客户案例',
      '翻译版本须核对术语、数字与免责声明，不能只做字面机器翻译',
      '发现自动化错误时按更正机制处理',
    ],
  },
  {
    title: '9. 更正、撤稿与版本',
    desc: '读者可通过文末邮箱提交事实错误、失效链接或引用问题。我们会在合理期限内核查：小错误直接更正并更新日期；影响结论的重大错误发布更正说明；无法确认来源或存在严重误导的内容撤稿或降级。',
    points: [
      '更正时保留原链接，不通过删除页面掩盖错误',
      '涉及检测性能、认证或法规的更正优先处理',
      '重大更正通过页面提示或订单沟通渠道通知',
      '历史报告不因后续标准变化自动失效，但应结合日期解读',
    ],
  },
  {
    title: '10. 兽医与人体使用免责',
    desc: '本站及子站内容仅供赛鸽/禽类科普、育种与实验室信息参考，不构成兽医诊断或治疗建议，也不构成人体医疗建议。动物出现疾病症状时，请咨询执业兽医师；人体健康问题请咨询医生。',
    points: [
      '症状不能单独用于确诊，实验室检测是诊断的一部分',
      '单次阴性不排除感染；阳性不必然等于临床发病',
      '用药与处置方案以执业兽医师意见为准',
      '详细边界见免责声明页',
    ],
  },
  {
    title: '11. 更新与联系',
    desc: '本政策随服务、科学证据与法规变化更新，页面标注最近更新日期。对内容、引用、更正或合作有疑问，请联系张家口赛诺生物科技有限公司。',
    points: [
      '内容与证据：martin@senobiocorp.com',
      '电话 | 微信：+86 15612372623',
      '地址：中国河北省张家口市桥东区北硅谷 3 号楼',
    ],
  },
];
---

<BaseLayout {title} {description} canonical="/zhishi/neirong-zhengce/" jsonLd={articleJsonLd} type="article">
  <Header />

  <main id="main">

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <h1 class="text-4xl font-bold">内容与证据政策</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        科学、透明、可溯源——这是本站内容的三条底线。以下规则说明我们如何写、如何引用、如何更正，以及哪些结论不能越过证据边界。
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="mx-auto max-w-3xl space-y-8">
      {sections.map((s) => (
        <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
          <h2 class="text-2xl font-bold text-gray-900">{s.title}</h2>
          <p class="mt-3 leading-relaxed text-gray-700">{s.desc}</p>
          <ul class="mt-4 space-y-2">
            {s.points.map((p) => (
              <li class="flex items-start gap-2 text-sm text-gray-600">
                <span class="mt-0.5 text-brand-600">✓</span> {p}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-2xl font-bold text-gray-900">相关资源</h2>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/zhishi/jishu-yuanli/" class="btn-outline">基因检测技术原理</a>
          <a href="/zhishi/baogao-jiedu/" class="btn-outline">报告解读指南</a>
          <a href="/mianze-shengming/" class="btn-outline">免责声明</a>
          <a href="/yinsi/" class="btn-outline">隐私政策</a>
          <a href="/tiaokuan/" class="btn-outline">服务条款</a>
          <a href="https://research.senopigeon.com/research/evidence-grading/" class="btn-outline">证据分级体系</a>
        </div>
      </div>
    </div>
  </section>

    </main>

  <Footer />
</BaseLayout>
