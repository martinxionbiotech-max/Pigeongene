---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { dnaKits } from '../../data/kits';

export function getStaticPaths() {
  return dnaKits.map((kit) => ({
    params: { slug: kit.slug },
    props: { kit },
  }));
}

const { kit } = Astro.props;

const siteUrl = 'https://pigeongene.com';
const pageUrl = `${siteUrl}/shijihe/${kit.slug}/`;

const title = `${kit.name} | 禽类分子诊断试剂盒`;
const description = `${kit.name}（${kit.en}）：检测目标 ${kit.target}，技术 ${kit.tech}，规格 ${kit.spec}。${kit.intro}`;

const productJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: kit.name,
    alternateName: kit.en,
    description: kit.intro,
    url: pageUrl,
    category: kit.category,
    brand: { '@type': 'Brand', name: 'SENO' },
    manufacturer: { '@id': `${siteUrl}/#organization` },
    additionalProperty: [
      { '@type': 'PropertyValue', name: '检测目标', value: kit.target },
      { '@type': 'PropertyValue', name: '检测技术', value: kit.tech },
      { '@type': 'PropertyValue', name: '规格', value: kit.spec },
      { '@type': 'PropertyValue', name: '保存条件', value: kit.storage },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '检测试剂盒', item: `${siteUrl}/shijihe/` },
      { '@type': 'ListItem', position: 3, name: kit.name, item: pageUrl },
    ],
  },
];

const related = dnaKits.filter((k) => k.category === kit.category && k.slug !== kit.slug);
---

<BaseLayout {title} {description} canonical={`/shijihe/${kit.slug}/`} jsonLd={productJsonLd}>
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-brand-100">
        <a href="/" class="hover:text-white">首页</a> /
        <a href="/shijihe/" class="hover:text-white">检测试剂盒</a> /
        <span class="text-white">{kit.name}</span>
      </nav>
      <h1 class="mt-4 text-3xl font-bold md:text-4xl">{kit.name}</h1>
      <p class="mt-3 text-sm text-brand-200">{kit.en}</p>
      <span class="mt-4 inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-medium text-white">{kit.category}</span>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-gray-900">产品介绍</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{kit.intro}</p>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">技术特点</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {[
            { icon: '🎯', title: '高特异性', desc: '针对病原保守区设计特异性引物与探针，减少非特异扩增。' },
            { icon: '🔬', title: '高灵敏度', desc: '荧光探针法灵敏度高，可检出低拷贝数的核酸。' },
            { icon: '🛡️', title: '防污染', desc: '内置 dUTP/UNG 系统，消除 PCR 气溶胶残留导致的假阳性。' },
            { icon: '📊', title: '结果可靠', desc: '配套内参质控，确保检测过程与结果的可信度。' },
          ].map((f) => (
            <div class="card">
              <div class="text-2xl">{f.icon}</div>
              <h3 class="mt-2 font-semibold text-gray-900">{f.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{f.desc}</p>
            </div>
          ))}
        </div>

        <h2 class="mt-10 text-2xl font-bold text-gray-900">检测流程</h2>
        <ol class="mt-4 space-y-3">
          {[
            '样本采集：规范采集喉拭子、泄殖腔拭子或粪便样本',
            '核酸提取：提取样本中的 DNA/RNA',
            '加样扩增：加入反应体系，上机扩增',
            '结果判读：根据荧光信号与内参判读结果',
          ].map((step, i) => (
            <li class="flex items-start gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-600 text-xs font-bold text-white">{i + 1}</span>
              <span class="text-gray-700">{step}</span>
            </li>
          ))}
        </ol>
      </div>

      <aside class="space-y-6">
        <div class="card bg-brand-50/50">
          <h3 class="text-lg font-semibold text-gray-900">产品参数</h3>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="font-medium text-gray-500">检测目标</dt>
              <dd class="mt-1 font-semibold text-gray-900">{kit.target}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">检测技术</dt>
              <dd class="mt-1 text-gray-700">{kit.tech}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">规格</dt>
              <dd class="mt-1 text-gray-700">{kit.spec}</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">保存条件</dt>
              <dd class="mt-1 text-gray-700">{kit.storage}</dd>
            </div>
          </dl>
          <a href="/lianxi/" class="btn-primary mt-6 w-full">咨询采购</a>
        </div>

        <div class="card bg-accent-500/10">
          <h3 class="text-lg font-semibold text-gray-900">温馨提示</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">
            试剂盒仅供科研与专业检测使用，检测结果应由专业兽医或实验室人员结合临床综合判读。样本采集与操作请严格遵循说明，避免交叉污染。
          </p>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-gray-50 py-16">
      <div class="container-x">
        <h2 class="text-2xl font-bold text-gray-900">同类试剂盒</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <a href={`/shijihe/${r.slug}/`} class="card flex items-center gap-3 hover:border-brand-300">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-lg">🧪</div>
              <div>
                <h3 class="font-semibold text-gray-900">{r.name}</h3>
                <p class="text-xs text-gray-500">{r.en}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>
