---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogExtras } from '../../data/blogExtras';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Hand-written English posts live in `blog` with lang: 'en'. They must never
  // generate a Chinese URL; their canonical English URL is /en/blog/<slug>/.
  return posts
    .filter((post) => (post.data.lang || 'zh-CN') !== 'en')
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description: rawDescription, pubDate, category, tags, author, authorRole, updatedDate, lang } = post.data;

const postLang = lang || 'zh-CN';

const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/blog/${post.id}/`;

// Only advertise an English alternate when a real English page will be built.
const blogEnPosts = await getCollection('blog-en');
const enSlugs = new Set(blogEnPosts.map((p) => p.id));
const hasEn = enSlugs.has(post.id);
const hreflang = hasEn
  ? [
      { lang: 'zh-CN', href: pageUrl },
      { lang: 'en', href: `${siteUrl}/en/blog/${post.id}/` },
      { lang: 'x-default', href: pageUrl },
    ]
  : [
      { lang: 'zh-CN', href: pageUrl },
      { lang: 'x-default', href: pageUrl },
    ];

const descSuffix = category.includes('Genetics')
  ? '本文从基因功能、研究证据与育种应用三个层面梳理关键点，并明确候选基因的解读边界。'
  : category.includes('Health')
    ? '本文结合赛鸽实验室检测与鸽舍管理实践，梳理病原特点、检测意义与防控要点。'
    : '本文结合赛鸽实验室检测与育种实践，梳理关键要点、证据边界与常见误区。';
const description =
  rawDescription.length >= 70 ? rawDescription : `${rawDescription}${descSuffix}`;

const authorIsCompany = /SENO|赛诺|Zhangjiakou/i.test(author);
const articleJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: pageUrl,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate || pubDate).toISOString(),
    author: authorIsCompany
      ? { '@type': 'Organization', name: author, '@id': `${siteUrl}/#organization` }
      : {
          '@type': 'Person',
          name: author,
          ...(authorRole ? { jobTitle: authorRole } : {}),
          affiliation: { '@id': `${siteUrl}/#organization` },
        },
    publisher: { '@id': `${siteUrl}/#organization` },
    keywords: tags.join(','),
    inLanguage: postLang,
    mainEntityOfPage: pageUrl,
    image: `${siteUrl}/wp-content/uploads/Racing-Pigeon-Performance-DNA-Testing-scaled.webp`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '专业文章', item: `${siteUrl}/blog/` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];

const extra = blogExtras[post.id];

const fmtDate = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<BaseLayout {title} {description} canonical={`/blog/${post.id}/`} {hreflang} jsonLd={articleJsonLd} type="article">
  <Header />

  <main id="main">

  <article>
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">首页</a> /
          <a href="/blog/" class="hover:text-white">专业文章</a> /
          <span class="text-white">{title}</span>
        </nav>
        <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-tight md:text-4xl">{title}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-brand-100">
          <span>{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{category}</span>
        </div>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-3xl">
        <div class="prose prose-brand max-w-none">
          <Content />
        </div>
        {extra && (
          <section class="mt-10">
            <h2 class="text-2xl font-bold text-gray-900">{extra.heading}</h2>
            {extra.body.map((p) => <p class="mt-4 leading-relaxed text-gray-700">{p}</p>)}
            <ul class="mt-4 space-y-2 text-gray-700">
              {extra.bullets.map((b) => <li class="flex items-start gap-2"><span class="mt-1 text-brand-600">◆</span><span>{b}</span></li>)}
            </ul>
          </section>
        )}

        <div class="mt-10 rounded-xl border border-brand-100 bg-brand-50/60 p-5 text-sm leading-relaxed text-gray-700">
          <p><strong>范围与证据说明：</strong>本文用于赛鸽育种与健康管理参考，不构成兽医诊断、治疗或成绩保证。文中的研究结论以原始论文为准；可点击来源与文献汇总见<a href="/cankao/" class="font-semibold text-brand-700 underline">科学参考</a>，完整边界见<a href="/mianze-shengming/" class="font-semibold text-brand-700 underline">免责声明</a>。</p>
        </div>

        <div class="mt-10 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="rounded bg-gray-100 px-3 py-1 text-sm text-gray-600">{t}</span>
          ))}
        </div>
        <div class="mt-10 rounded-xl border border-brand-100 bg-brand-50/50 p-6 text-center">
          <p class="text-gray-700">需要赛鸽基因检测或病毒检测服务？</p>
          <div class="mt-4 flex flex-wrap justify-center gap-3">
            <a href="/jiyin-jiance/" class="btn-primary">飞行能力基因检测</a>
            <a href="/bingdu-jiance/" class="btn-outline">赛鸽病毒检测</a>
          </div>
        </div>
        <div class="mt-8">
          <a href="/blog/" class="text-sm font-medium text-brand-600 hover:text-brand-700">← 返回全部文章</a>
        </div>
      </div>
    </section>
  </article>

    </main>

  <Footer />
</BaseLayout>
