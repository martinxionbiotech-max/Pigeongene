---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, category, tags, author, authorRole, updatedDate } = post.data;

const siteUrl = 'https://pigeongene.com';
const pageUrl = `${siteUrl}/blog/${post.slug}/`;

const articleJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: pageUrl,
    datePublished: pubDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    author: {
      '@type': 'Person',
      name: author,
      ...(authorRole ? { jobTitle: authorRole } : {}),
      affiliation: { '@id': `${siteUrl}/#organization` },
    },
    publisher: { '@id': `${siteUrl}/#organization` },
    keywords: tags.join(','),
    inLanguage: 'zh-CN',
    mainEntityOfPage: pageUrl,
    image: `${siteUrl}/wp-content/uploads/Racing-Pigeon-Performance-DNA-Testing-scaled.jpg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '专业文章', item: `${siteUrl}/blog/` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];

const fmtDate = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<BaseLayout {title} {description} canonical={`/blog/${post.slug}/`} jsonLd={articleJsonLd} type="article">
  <Header />

  <article>
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">首页</a> /
          <a href="/blog/" class="hover:text-white">专业文章</a> /
          <span class="text-white">{title}</span>
        </nav>
        <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-tight md:text-4xl">{title}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-brand-100">
          <span>{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{category}</span>
        </div>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-3xl">
        <div class="prose prose-brand max-w-none">
          <Content />
        </div>
        <div class="mt-10 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="rounded bg-gray-100 px-3 py-1 text-sm text-gray-600">{t}</span>
          ))}
        </div>
        <div class="mt-10 rounded-xl border border-brand-100 bg-brand-50/50 p-6 text-center">
          <p class="text-gray-700">需要赛鸽基因检测或病毒检测服务？</p>
          <div class="mt-4 flex flex-wrap justify-center gap-3">
            <a href="/jiyin-jiance/" class="btn-primary">飞行能力基因检测</a>
            <a href="/bingdu-jiance/" class="btn-outline">赛鸽病毒检测</a>
          </div>
        </div>
        <div class="mt-8">
          <a href="/blog/" class="text-sm font-medium text-brand-600 hover:text-brand-700">← 返回全部文章</a>
        </div>
      </div>
    </section>
  </article>

  <Footer />
</BaseLayout>
