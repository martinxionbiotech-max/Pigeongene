---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = '专业文章 | 赛鸽基因检测与病毒检测知识';
const description = '赛鸽基因检测、病毒检测、DNA 鉴定、育种与健康管理领域的专业科普文章，由赛诺生物科技实验室团队撰写。';

const siteUrl = 'https://senopigeon.com';
const pageUrl = `${siteUrl}/blog/`;

const listJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '赛鸽基因检测专业文章',
    url: pageUrl,
    description,
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '专业文章', item: pageUrl },
    ],
  },
];

const categories = [...new Set(posts.map((p) => p.data.category))];

const fmtDate = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<BaseLayout {title} {description} canonical="/blog/" jsonLd={listJsonLd} type="article">
  <Header />

  <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
    <div class="container-x">
      <nav class="text-sm text-brand-100">
        <a href="/" class="hover:text-white">首页</a> /
        <span class="text-white">专业文章</span>
      </nav>
      <h1 class="mt-4 text-4xl font-bold">专业文章</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-100">
        赛鸽基因检测、病毒检测与科学育种领域的深度科普，由实验室团队撰写。
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    {categories.map((cat) => (
      <div class="mb-12">
        <h2 class="mb-6 text-xl font-bold text-gray-900">{cat}</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts
            .filter((p) => p.data.category === cat)
            .map((post) => (
              <a href={`/blog/${post.slug}/`} class="group card flex flex-col hover:border-brand-300">
                <div class="flex items-center gap-2 text-xs text-brand-600">
                  <span class="rounded-full bg-brand-50 px-2 py-0.5">{post.data.category}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
                </div>
                <h3 class="mt-3 text-lg font-bold text-gray-900 group-hover:text-brand-700">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm text-gray-600">{post.data.description}</p>
                <div class="mt-auto flex flex-wrap gap-1 pt-4">
                  {post.data.tags.map((t) => (
                    <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-500">{t}</span>
                  ))}
                </div>
              </a>
            ))}
        </div>
      </div>
    ))}
  </section>

  <section class="bg-gray-50 py-16">
    <div class="container-x text-center">
      <h2 class="section-title">需要专业检测服务？</h2>
      <p class="mt-4 text-gray-600">从基因到病原，为您的赛鸽建立完整的科学档案。</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/jiyin-jiance/" class="btn-primary">基因检测</a>
        <a href="/bingdu-jiance/" class="btn-outline">病毒检测</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
