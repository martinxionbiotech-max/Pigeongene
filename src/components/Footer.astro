---
import { isEnglishPath } from '../i18n/lang';

const year = new Date().getFullYear();
const isEn = isEnglishPath(Astro.url.pathname);
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="container-x grid gap-10 py-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2 font-bold text-brand-800">
        <img src="/wp-content/uploads/cropped-cropped-LOGO.png" alt={isEn ? 'SENO Biotech logo' : 'SENO 赛诺基因检测中心 LOGO'} class="h-9 w-9 rounded" width="512" height="512" />
        <span class="text-lg">{isEn ? 'Zhangjiakou SENO Biotech Co., Ltd.' : '张家口赛诺生物科技有限公司'}</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-gray-600">
        {isEn
          ? 'A National High-Tech Enterprise and key gene-testing laboratory in Zhangjiakou, focused on racing-pigeon flight-gene testing and pathogen testing — reliable, data-driven breeding and health management for pigeon fanciers worldwide.'
          : '国家高新技术企业、张家口市重点基因检测实验室，专注赛鸽飞行能力基因检测与病毒检测，为全球鸽友提供可靠、数据驱动的科学育种与健康管理方案。'}
      </p>
      <p class="mt-4 text-xs text-gray-400">
        {isEn
          ? 'Testing services on this site are for racing pigeons (avian / veterinary use) only — not for human medical diagnosis.'
          : '本网站检测服务仅用于赛鸽（禽类/兽用）领域，不适用于人体医学诊断。'}
      </p>
      <div class="mt-6">
        <h2 class="text-sm font-semibold text-gray-900">{isEn ? 'Ecosystem sub-sites' : '生态子站'}</h2>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-600">
          <li><a href="https://genetics.senopigeon.com" target="_blank" rel="noopener" class="hover:text-brand-600">{isEn ? 'Genetics Knowledge Base →' : '遗传知识库 →'}</a></li>
          <li><a href="https://health.senopigeon.com" target="_blank" rel="noopener" class="hover:text-brand-600">{isEn ? 'Health Knowledge Base →' : '健康知识库 →'}</a></li>
          <li><a href="https://research.senopigeon.com" target="_blank" rel="noopener" class="hover:text-brand-600">{isEn ? 'Research Center →' : '科研中心 →'}</a></li>
        </ul>
      </div>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-gray-900">{isEn ? 'Testing Services' : '检测服务'}</h2>
      <ul class="mt-4 space-y-2 text-sm text-gray-600">
        <li><a href={isEn ? '/en/flight-gene-test/' : '/jiyin-jiance/'} class="hover:text-brand-600">{isEn ? 'Flight Gene Test' : '飞行能力基因检测'}</a></li>
        <li><a href={isEn ? '/en/pathogen-testing/' : '/bingdu-jiance/'} class="hover:text-brand-600">{isEn ? 'Pathogen Testing' : '赛鸽病毒检测'}</a></li>
        <li><a href={isEn ? '/en/dna-id-kinship/' : '/dna-shenfenzheng/'} class="hover:text-brand-600">{isEn ? 'DNA ID & Kinship' : 'DNA 身份证 | 亲缘鉴定'}</a></li>
        <li><a href={isEn ? '/en/sampling/' : '/caiyang/'} class="hover:text-brand-600">{isEn ? 'Sampling Guide' : '采样指南'}</a></li>
        <li><a href={isEn ? '/en/kits/' : '/shijihe/'} class="hover:text-brand-600">{isEn ? 'Test Kits' : '检测试剂盒'}</a></li>
        <li><a href={isEn ? '/en/laboratory/' : '/shiyanshi/'} class="hover:text-brand-600">{isEn ? 'Lab Setup' : '实验室建设'}</a></li>
        <li><a href={isEn ? '/en/distributors/' : '/daili/'} class="hover:text-brand-600">{isEn ? 'Distributor Program' : '代理商合作'}</a></li>
        <li><a href={isEn ? '/en/knowledge/' : '/zhishi/'} class="hover:text-brand-600">{isEn ? 'Knowledge Center' : '知识中心'}</a></li>
        <li><a href={isEn ? '/en/blog/' : '/blog/'} class="hover:text-brand-600">{isEn ? 'Blog' : '专业文章'}</a></li>
        <li><a href={isEn ? '/en/references/' : '/cankao/'} class="hover:text-brand-600">{isEn ? 'Scientific References' : '科学参考'}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-gray-900">{isEn ? 'Help & Contact' : '帮助与联系'}</h2>
      <ul class="mt-4 space-y-2 text-sm text-gray-600">
        <li><a href={isEn ? '/en/sampling/' : '/caiyang/'} class="hover:text-brand-600">{isEn ? 'Sampling Guide' : '采样指南'}</a></li>
        <li><a href={isEn ? '/en/faq/' : '/faq/'} class="hover:text-brand-600">{isEn ? 'FAQ' : '常见问题'}</a></li>
        <li><a href={isEn ? '/en/contact/' : '/lianxi/'} class="hover:text-brand-600">{isEn ? 'Contact Us' : '联系我们'}</a></li>
        <li><a href={isEn ? '/en/about/' : '/guanyu/'} class="hover:text-brand-600">{isEn ? 'About Us' : '关于我们'}</a></li>
      </ul>
      <h2 class="mt-6 text-sm font-semibold text-gray-900">{isEn ? 'Contact' : '联系方式'}</h2>
      <ul class="mt-4 space-y-2 text-sm text-gray-600">
        <li><span aria-hidden="true">📧</span> <a href="mailto:martin@senobiocorp.com" class="hover:text-brand-600">martin@senobiocorp.com</a></li>
        <li><span aria-hidden="true">📞</span> <a href="tel:+8615612372623" class="hover:text-brand-600">+86 156 1237 2623</a></li>
        <li><span aria-hidden="true">📍</span> {isEn ? 'Building 3, North Silicon Valley, Qiaodong District, Zhangjiakou, Hebei, China' : '河北省张家口市桥东区北硅谷 3 号楼'}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-gray-200 py-5">
    <div class="container-x flex flex-col items-center justify-between gap-3 text-xs text-gray-500 sm:flex-row">
      <span>© {year} {isEn ? 'Zhangjiakou SENO Biotech Co., Ltd. All rights reserved.' : '张家口赛诺生物科技有限公司（SENO Biotech）版权所有'}</span>
      <div class="flex gap-4">
        <a href={isEn ? '/en/privacy-policy/' : '/yinsi/'} class="hover:text-brand-600">{isEn ? 'Privacy Policy' : '隐私政策'}</a>
        <a href={isEn ? '/en/terms/' : '/tiaokuan/'} class="hover:text-brand-600">{isEn ? 'Terms of Service' : '服务条款'}</a>
        <a href={isEn ? '/en/content-policy/' : '/zhishi/neirong-zhengce/'} class="hover:text-brand-600">{isEn ? 'Content & Evidence Policy' : '内容与证据政策'}</a>
      </div>
    </div>
  </div>
</footer>
