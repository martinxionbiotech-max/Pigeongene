---
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  canonical?: string;
  jsonLd?: Record<string, any>[];
}

const {
  title,
  description,
  image = '/wp-content/uploads/home-hero-racing-pigeon.jpg',
  type = 'website',
  canonical,
  jsonLd = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://senopigeon.com');
const siteUrl = site.toString().replace(/\/$/, '');
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const BRAND = 'SENO 赛诺基因检测中心';
const brandSuffix = ` - ${BRAND}`;
const fullTitle = title.includes(BRAND) ? title : `${title}${brandSuffix}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: '张家口赛诺生物科技有限公司',
  alternateName: ['SENO Biotech Co., Ltd', '赛诺生物', 'PigeonGene'],
  legalName: '张家口赛诺生物科技有限公司',
  url: siteUrl,
  logo: `${siteUrl}/wp-content/uploads/cropped-cropped-LOGO.png`,
  image: `${siteUrl}/wp-content/uploads/home-hero-racing-pigeon.jpg`,
  description: '国家高新技术企业、张家口市重点基因检测实验室，专注赛鸽飞行能力基因检测、病毒检测与 DNA 身份证/亲缘鉴定。',
  foundingDate: '2014',
  numberOfEmployees: { '@type': 'QuantitativeValue', value: 15 },
  award: [
    '国家高新技术企业',
    '张家口市重点基因检测实验室',
    '科技型中小企业',
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'ISO 9001 质量管理体系认证',
  },
  knowsAbout: [
    '赛鸽飞行能力基因检测',
    '赛鸽病毒检测',
    'DNA 身份证',
    '亲缘鉴定',
    '实时荧光定量 PCR',
    '禽类分子诊断',
  ],
  areaServed: 'Worldwide',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+86 13323237275',
      contactType: 'sales',
      email: 'martin@senobiocorp.com',
      availableLanguage: ['zh-CN', 'en'],
      areaServed: 'Worldwide',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '桥东区北硅谷 3 号楼',
    addressLocality: '张家口市',
    addressRegion: '河北省',
    postalCode: '075000',
    addressCountry: 'CN',
  },
  sameAs: [
    siteUrl,
    'https://genetics.senopigeon.com',
    'https://health.senopigeon.com',
    'https://research.senopigeon.com',
    'https://tools.senopigeon.com',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: BRAND,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'zh-CN',
};

const allJsonLd = [orgSchema, websiteSchema, ...jsonLd];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="809" />
    <meta property="og:image:height" content="607" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {allJsonLd.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="min-h-screen bg-white">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white">
      跳到主要内容
    </a>
    <slot />
  </body>
</html>
