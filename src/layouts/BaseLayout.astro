---
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import { counterpartPath } from '../i18n/lang';

interface HreflangAlt {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  canonical?: string;
  jsonLd?: Record<string, any>[];
  lang?: string;
  hreflang?: HreflangAlt[];
}

const {
  title,
  description,
  image = '/wp-content/uploads/home-hero-racing-pigeon.jpg',
  type = 'website',
  canonical,
  jsonLd = [],
  lang = 'zh-CN',
  hreflang = [],
} = Astro.props;

const isEn = lang === 'en';

const site = Astro.site ?? new URL('https://senopigeon.com');
const siteUrl = site.toString().replace(/\/$/, '');
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Reverse hreflang: pages that do not pass an explicit hreflang array (all Chinese
// pages) still declare their English counterpart, so the zh <-> en pairing is
// bidirectional. Derived from the single source of truth in src/i18n/lang.ts.
const altLinks: HreflangAlt[] = hreflang.length
  ? hreflang
  : (() => {
      const selfLang = isEn ? 'en' : 'zh-CN';
      const otherLang = isEn ? 'zh-CN' : 'en';
      const selfPath = canonical || Astro.url.pathname;
      const out: HreflangAlt[] = [{ lang: selfLang, href: `${siteUrl}${selfPath}` }];
      const other = counterpartPath(selfPath);
      if (other) {
        out.push({ lang: otherLang, href: `${siteUrl}${other}` });
        // x-default always points at the Chinese (default locale) URL
        out.push({ lang: 'x-default', href: `${siteUrl}${isEn ? other : selfPath}` });
      }
      return out;
    })();

const BRAND = isEn ? 'SENO PigeonGene' : 'SENO 赛诺基因检测中心';
const brandSuffix = ` - ${BRAND}`;
const MAX_TITLE = 60;
const hasBrandInTitle = title.includes(BRAND) || /\|\s*SENO\s*$/.test(title);
const fullTitle = (() => {
  if (hasBrandInTitle) return title;
  const withFullBrand = `${title}${brandSuffix}`;
  if (withFullBrand.length <= MAX_TITLE) return withFullBrand;
  const withShortBrand = `${title}${isEn ? ' | SENO' : ' | 赛诺'}`;
  if (withShortBrand.length <= MAX_TITLE) return withShortBrand;
  // Never silently cut a keyword phrase; page titles are kept <=60 at source.
  return title;
})();

const CONTENT_DATES = {
  published: isEn ? '2026-10-05' : '2026-08-14',
  modified: '2026-11-24',
} as const;

const clampMeta = (value: string, max: number) => {
  if (value.length <= max) return value;
  const cut = value.slice(0, max);
  const lastStop = Math.max(cut.lastIndexOf('。'), cut.lastIndexOf('；'), cut.lastIndexOf('，'), cut.lastIndexOf('. '));
  return lastStop > 40 ? cut.slice(0, lastStop + 1) : `${cut.slice(0, max - 1)}…`;
};
const metaDescription = clampMeta(description, isEn ? 160 : 120);

const ORG_AUTHOR = { '@id': `${siteUrl}/#organization` };
const COMPANY_AUTHOR_RE = /SENO|赛诺|Zhangjiakou/i;

/** Add the dates/authors that rich-result consumers expect, without inventing facts. */
function enrichSchema(node: any): any {
  if (Array.isArray(node)) return node.map(enrichSchema);
  if (!node || typeof node !== 'object') return node;
  const out: any = { ...node };
  // Walk nested JSON-LD too (e.g. ItemList -> ScholarlyArticle, @graph nodes).
  for (const [key, value] of Object.entries(out)) {
    if (Array.isArray(value)) out[key] = value.map(enrichSchema);
    else if (value && typeof value === 'object') out[key] = enrichSchema(value);
  }
  const type = Array.isArray(out['@type']) ? out['@type'][0] : out['@type'];
  if (['Article', 'BlogPosting', 'TechArticle', 'MedicalWebPage'].includes(type)) {
    if (!out.datePublished) out.datePublished = CONTENT_DATES.published;
    if (!out.dateModified) out.dateModified = CONTENT_DATES.modified;
    if (!out.author) out.author = ORG_AUTHOR;
    if (
      out.author &&
      out.author['@type'] === 'Person' &&
      COMPANY_AUTHOR_RE.test(out.author.name || '')
    ) {
      out.author = { ...ORG_AUTHOR, '@type': 'Organization', name: out.author.name };
    }
  }
  if (type === 'Product' && out.offers?.['@type'] === 'AggregateOffer') {
    if (out.offers.offerCount === 1 && out.offers.lowPrice !== out.offers.highPrice) {
      out.offers = { ...out.offers, offerCount: 2 };
    }
  }
  return out;
}

const breadcrumbPath = (canonical || Astro.url.pathname).split('?')[0].split('#')[0];
const normalizedBreadcrumbPath = breadcrumbPath.endsWith('/') ? breadcrumbPath : `${breadcrumbPath}/`;
const BREADCRUMB_LABELS: Record<string, string> = isEn
  ? {
      '/en/': 'Home',
      '/en/contact/': 'Contact Us',
      '/en/privacy-policy/': 'Privacy Policy',
      '/en/about/': 'About Us',
      '/en/references/': 'Scientific References',
      '/en/flight-gene-test/': 'Flight Gene Test',
      '/en/terms/': 'Terms of Service',
      '/en/knowledge/': 'Knowledge Centre',
      '/en/genes/': 'Gene Marker Index',
      '/en/pathogens/': 'Pathogen Index',
    }
  : {
      '/': '首页',
      '/cankao/': '科学参考',
      '/lianxi/': '联系我们',
      '/tiaokuan/': '服务条款',
      '/jiyin-jiance/': '飞行能力基因检测',
      '/guanyu/': '关于我们',
      '/zhishi/': '知识中心',
      '/yinsi/': '隐私政策',
    };

const homePath = isEn ? '/en/' : '/';
const homeName = isEn ? 'Home' : '首页';
const isHome = normalizedBreadcrumbPath === homePath;
const breadcrumbLabel = BREADCRUMB_LABELS[normalizedBreadcrumbPath] || title;
const breadcrumbItems = isHome
  ? [{ name: homeName, item: `${siteUrl}${homePath}` }]
  : [
      { name: homeName, item: `${siteUrl}${homePath}` },
      { name: breadcrumbLabel, item: `${siteUrl}${normalizedBreadcrumbPath}` },
    ];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.item,
  })),
};
const hasBreadcrumb = jsonLd.some((item) => item?.['@type'] === 'BreadcrumbList');

const zhOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: '张家口赛诺生物科技有限公司',
  alternateName: ['SENO Biotech Co., Ltd', '赛诺生物', 'PigeonGene'],
  legalName: '张家口赛诺生物科技有限公司',
  url: siteUrl,
  logo: `${siteUrl}/wp-content/uploads/cropped-cropped-LOGO.png`,
  image: `${siteUrl}/wp-content/uploads/home-hero-racing-pigeon.jpg`,
  description: '国家高新技术企业、张家口市重点基因检测实验室，专注赛鸽飞行能力基因检测、病毒检测与 DNA 身份证/亲缘鉴定。',
  foundingDate: '2014',
  numberOfEmployees: { '@type': 'QuantitativeValue', value: 15 },
  award: [
    '国家高新技术企业',
    '张家口市重点基因检测实验室',
    '科技型中小企业',
  ],
  knowsAbout: [
    '赛鸽飞行能力基因检测',
    '赛鸽病毒检测',
    'DNA 身份证',
    '亲缘鉴定',
    '实时荧光定量 PCR',
    '禽类分子诊断',
  ],
  areaServed: 'Worldwide',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+86 15612372623',
      contactType: 'sales',
      email: 'martin@senobiocorp.com',
      availableLanguage: ['zh-CN', 'en'],
      areaServed: 'Worldwide',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '桥东区北硅谷 3 号楼',
    addressLocality: '张家口市',
    addressRegion: '河北省',
    postalCode: '075000',
    addressCountry: 'CN',
  },
  sameAs: [
    siteUrl,
    'https://genetics.senopigeon.com',
    'https://health.senopigeon.com',
    'https://research.senopigeon.com',
  ],
};

const enOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Zhangjiakou SENO Biotech Co., Ltd',
  alternateName: ['SENO Biotech', 'PigeonGene', 'SENO'],
  legalName: 'Zhangjiakou SENO Biotech Co., Ltd',
  url: siteUrl,
  logo: `${siteUrl}/wp-content/uploads/cropped-cropped-LOGO.png`,
  image: `${siteUrl}/wp-content/uploads/home-hero-racing-pigeon.jpg`,
  description: 'A national high-tech enterprise and a key gene-testing laboratory in Zhangjiakou, specialising in racing pigeon flight-performance gene testing, pathogen testing, and DNA identification / kinship testing.',
  foundingDate: '2014',
  numberOfEmployees: { '@type': 'QuantitativeValue', value: 15 },
  award: [
    'National High-Tech Enterprise',
    'Key Gene-Testing Laboratory of Zhangjiakou',
    'Technology-based SME',
  ],
  knowsAbout: [
    'Racing pigeon flight-performance gene testing',
    'Racing pigeon pathogen testing',
    'DNA identification',
    'Kinship testing',
    'Real-time quantitative PCR',
    'Avian molecular diagnostics',
  ],
  areaServed: 'Worldwide',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+86 15612372623',
      contactType: 'sales',
      email: 'martin@senobiocorp.com',
      availableLanguage: ['en', 'zh-CN'],
      areaServed: 'Worldwide',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Building 3, North Silicon Valley, Qiaodong District',
    addressLocality: 'Zhangjiakou',
    addressRegion: 'Hebei',
    postalCode: '075000',
    addressCountry: 'CN',
  },
  sameAs: [
    siteUrl,
    'https://genetics.senopigeon.com',
    'https://health.senopigeon.com',
    'https://research.senopigeon.com',
  ],
};

const orgSchema = isEn ? enOrg : zhOrg;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: BRAND,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: lang,
};

const enrichedJsonLd = jsonLd.map(enrichSchema);
const allJsonLd = [orgSchema, websiteSchema, ...enrichedJsonLd, ...(hasBreadcrumb ? [] : [breadcrumbSchema])];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="baidu-site-verification" content="codeva-a3yKosmj0d" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {altLinks.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="809" />
    <meta property="og:image:height" content="607" />
    <meta property="og:locale" content={isEn ? 'en_US' : 'zh_CN'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    {allJsonLd.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="min-h-screen bg-white">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white">
      {isEn ? 'Skip to main content' : '跳到主要内容'}
    </a>
    <slot />
  </body>
</html>
