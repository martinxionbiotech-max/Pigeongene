---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  canonical?: string;
}

const {
  title,
  description,
  image = '/wp-content/uploads/Racing-Pigeon-Performance-DNA-Testing-scaled.jpg',
  type = 'website',
  canonical,
} = Astro.props;

const site = Astro.site ?? new URL('https://pigeongene.com');
const siteUrl = site.toString().replace(/\/$/, '');
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} - SENO 赛鸽基因检测中心</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="SENO 赛鸽基因检测中心" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Organization JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: '张家口森诺生物科技有限公司',
      alternateName: 'SENO Biotech Co., Ltd',
      url: siteUrl,
      logo: `${siteUrl}/wp-content/uploads/cropped-cropped-LOGO.png`,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+86 13323237275',
        contactType: 'sales',
        email: 'martin@dnatestingexperts.com',
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '桥东区北硅谷 3 号楼',
        addressLocality: '张家口市',
        addressRegion: '河北省',
        addressCountry: 'CN',
      },
      sameAs: [],
    })} />
  </head>
  <body class="min-h-screen bg-white">
    <slot />
  </body>
</html>
